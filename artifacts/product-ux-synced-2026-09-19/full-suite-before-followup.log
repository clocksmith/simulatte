              <div class="journey-progress" aria-hidden="true"><span id="journey-progress-fill"></span></div>
              <div class="journey-hud-line">
                <strong id="metric-state">active</strong>
                <span id="metric-distance">0 m</span>
                <span id="metric-time">0:00</span>
              </div>
              <div class="hud-contract-values sr-only" aria-hidden="true">
                <span id="metric-speed">0 m/s</span>
                <span id="metric-tick">0</span>
                <span id="metric-route">unplanned</span>
                <span id="metric-bet">none</span>
                <span id="metric-settlement">none</span>
                <span id="metric-calibration">0 / 0</span>
              </div>
            </section>
          <details id="experience-summary" class="experience-summary sim-surface" aria-live="polite" data-semantic-label-exclusion hidden>
                  <summary>Results and explanation</summary>
                  <header>
                    <span id="experience-summary-state" class="sim-label">Ready</span>
                    <strong id="experience-summary-title"></strong>
                  </header>
                  <p id="experience-summary-description"></p>
                  <div class="experience-story">
                    <div>
                      <span class="sim-label">Now</span>
                      <strong id="experience-summary-event"></strong>
                    </div>
                    <div>
                      <span class="sim-label">Why</span>
                      <span id="experience-summary-narrative"></span>
                    </div>
                  </div>
                  <dl id="experience-summary-stats"></dl>
                  <p id="experience-summary-comparison" class="experience-summary-comparison"></p>
                </details>
        </section>
    
        <div id="decisions-backdrop" class="drawer-backdrop" hidden></div>
        <aside id="decisions-drawer" class="evidence-panel sim-surface" role="dialog" aria-modal="true" inert aria-label="Controls and evidence" aria-hidden="true">
          <header class="evidence-heading">
            <div>
              <strong id="decision-title">Experiment controls</strong>
              <p id="decision-meta">Change parameters before Start. Inspect evidence after the run.</p>
            </div>
            <button id="decisions-close" class="drawer-close" type="button" aria-label="Close decisions">×</button>
          </header>
    
          <section id="plugin-inspector" aria-label="Simulation parameters and evidence"></section>
          <details id="scene-actions" class="evidence-section"><summary>Scene actions</summary><section id="plugin-map-ui" class="plugin-map-ui" aria-label="Experience view" data-semantic-label-exclusion></section></details>
          <details id="mission-authoring" class="evidence-section" hidden><summary>Author a mission</summary><label id="mission-field" class="mission-field" for="mission-input">
                <span class="sr-only">Describe a mission</span>
                <textarea id="mission-input" rows="2" spellcheck="false" aria-describedby="mission-error" placeholder="Where should the agent go?"></textarea>
