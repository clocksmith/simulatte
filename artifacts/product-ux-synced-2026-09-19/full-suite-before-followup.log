                </div>
                <section id="world-model-panel" class="world-model-panel" aria-label="Compiled world model receipt">
                  <div class="world-model-head">
                    <strong>WorldSpec</strong>
                    <span id="world-model-status" class="world-model-status">blank</span>
                  </div>
                  <div id="world-model-summary" class="world-model-summary">blank construction plane</div>
                  <div id="world-model-chips" class="world-model-chips" aria-label="World model counts"></div>
                  <div class="prompt-more-section-title">Receipts</div>
                  <pre id="spec-preview" class="sim-code spec-preview physics-spec-preview" tabindex="0">{}</pre>
    
    
                </section>
              </div>
            </details>
          </div>
            </details>
          </div>
          <input id="simulation-name" type="hidden" value="">
        </section>
    
        <section class="create-preview" aria-label="Simulation preview">
          <div class="create-preview-bar">
            <span id="create-preview-title">Preview</span>
            <div class="create-preview-actions" id="create-preview-actions" hidden>
              <button id="pause-lab" class="sim-action" type="button" aria-pressed="false">Pause</button>
              <button id="reset-lab" class="sim-action" type="button">Restart</button>
              <button id="export-lab" class="sim-action" type="button">Export</button>
            </div>
          </div>
          <div class="physics-canvas-wrap">
            <div class="create-empty" id="create-empty">
              <span class="create-empty-mark" aria-hidden="true">+</span>
              <h2>Your simulation starts here.</h2>
              <p>Describe a scene, then select Run simulation.</p>
            </div>
          <canvas id="physics-canvas" tabindex="0" aria-label="Interactive Simulatte physics canvas"
            aria-describedby="world-interaction-help" data-scene-visible="false"></canvas>
          <p id="world-interaction-help" class="sr-only">Click an object to select it. Drag to move or push it. Use arrow keys to nudge it, Space to apply an impulse, Enter to activate it, and Escape to clear the selection.</p>
          <canvas id="loading-canvas" aria-label="Snake loading canvas" hidden></canvas>
          </div>
          <p class="create-interaction-hint" id="create-interaction-hint" hidden>Click an object to select it. Drag to interact.</p>
        </section>
    
        <dialog id="world-spec-reconciliation-dialog" class="neural-consent-dialog world-spec-reconciliation-dialog"
          aria-labelledby="world-spec-reconciliation-title" data-state="idle">
          <div class="neural-consent-body">
            <h2 id="world-spec-reconciliation-title">Reconcile accepted edits</h2>
            <p id="world-spec-reconciliation-summary">Accepted edits require a decision before recompilation can execute.</p>
            <p id="world-spec-reconciliation-conflicts" class="world-spec-reconciliation-conflicts" data-state="ready"></p>
            <details class="world-spec-reconciliation-detail">
              <summary>Inspect affected fields</summary>
              <ol id="world-spec-reconciliation-fields"></ol>
            </details>
            <div class="neural-consent-actions world-spec-reconciliation-actions">
              <button id="cancel-world-spec-reconciliation" class="sim-action" type="button">Keep current world</button>
              <button id="accept-recompiled-world-spec" class="sim-action" type="button">Use fresh compilation</button>
              <button id="preserve-world-spec-overrides" class="sim-action sim-action-primary" type="button">Keep edits and recompile</button>
            </div>
          </div>
        </dialog>
    
        <dialog id="neural-model-dialog" class="neural-consent-dialog" aria-labelledby="neural-model-title">
          <div class="neural-consent-body">
            <h2 id="neural-model-title">Enable local Qwen embedding?</h2>
            <p data-neural-model="surface-use">Blank uses Qwen embeddings for open-vocabulary retrieval. Deterministic scoring and refusal remain authoritative.</p>
            <div class="neural-model-list" aria-label="Models stored on this device">
              <div class="neural-model-row"><span data-neural-model="embedding-name">Qwen embedding</span><span data-neural-model="embedding-size">Loading size</span></div>
