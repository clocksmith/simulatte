    <body class="create-app">
      <div class="sim-theme-control" data-theme-control>
        <button type="button" aria-label="Theme follows system. Switch to Light theme.">
          <span class="sim-theme-icon-stack" aria-hidden="true">
            <span data-theme-icon="system">◐</span>
            <span data-theme-icon="light">☼</span>
            <span data-theme-icon="dark">☾</span>
          </span>
          <span class="sim-theme-control-label" data-theme-label aria-hidden="true">System</span>
        </button>
      </div>
      <header class="create-header">
        <nav class="sim-product-nav" aria-label="Simulatte">
          <a class="create-brand" href="https://simulatte.world/" data-local-href="../">Simulatte</a>
          <span class="create-product">Create</span>
          <a class="create-back" href="https://simulatte.world/" data-local-href="../">Explore simulations</a>
        </nav>
        <button id="prompt-dock-toggle" class="sim-action" type="button" aria-controls="create-editor" aria-expanded="true">Hide editor</button>
      </header>
      <main class="physics-stage" aria-label="Create a simulation" data-create-state="empty">
        <section id="create-editor" class="physics-panel prompt-dock" aria-label="Simulation editor">
          <div class="prompt-dock-head">
            <p class="create-eyebrow">FROM IDEA TO SIMULATION</p>
            <h1>Make something move.</h1>
            <p>Describe a scene. Run it, explore it, then make it yours.</p>
          </div>
    
          <div class="prompt-dock-core">
            <div class="builder-row">
              <label class="create-prompt-label" for="build-prompt">What do you want to simulate?</label>
              <textarea id="build-prompt" class="sim-field" aria-label="Simulation request" placeholder="A red ball bouncing on the ground…" aria-describedby="create-prompt-help"></textarea>
              <p id="create-prompt-help" class="create-help">Start with an object, then add motion or surroundings.</p>
              <div class="create-examples" aria-label="Starting ideas">
                <span>Try an idea</span>
                <button type="button" data-create-prompt="a red ball">A red ball</button>
                <button type="button" data-create-prompt="a blue cube">A blue cube</button>
                <button type="button" data-create-prompt="a pendulum">A pendulum</button>
              </div>
              <div class="prompt-actions" aria-label="Create actions">
                <button id="build-lab" class="primary-action prompt-side-action sim-action sim-action-primary" type="button" aria-label="Run simulation" disabled>
                  <span class="prompt-action-icon" aria-hidden="true">↵</span>
                  <span class="prompt-action-label">Run simulation</span>
                </button>
                <button id="shuffle-prompt" class="example-chip prompt-side-action sim-action" type="button" aria-label="Run a random example" title="Run a random example">
                  <span class="prompt-action-icon" aria-hidden="true">⇄</span>
                  <span class="prompt-action-label">Surprise me</span>
                </button>
              </div>
              <input id="blank-neural-models" type="checkbox" hidden aria-describedby="blank-neural-model-note">
              <span id="blank-neural-model-note" class="sr-only">Deterministic language pipeline is active.</span>
            </div>
    
            <div class="create-run-status" role="status" aria-live="polite">
              <span class="create-status-dot" aria-hidden="true"></span>
              <div><strong id="create-status-title">Ready to create</strong><p id="create-status-message">Choose an idea or write your own.</p></div>
            </div>
            <p class="create-local-note">No account needed. Your scene runs in this browser.</p>
            <details id="create-tools" class="create-tools">
              <summary>Tools &amp; settings</summary>
                <details class="model-selection-panel">
                  <summary>Model settings</summary>
                  <div id="model-selection-controls" class="model-selection-controls" aria-label="Pipeline model selection"></div>
                </details>
            <div class="create-inspectors">
                  <details id="world-spec-editor-panel" class="world-spec-editor-panel">
                    <summary class="sim-action">Edit simulation</summary>
                    <div class="world-spec-editor-controls">
                      <label for="world-spec-edit-rationale">Edit rationale</label>
                      <input id="world-spec-edit-rationale" class="sim-field" type="text" placeholder="Why this change is required">
                      <textarea id="world-spec-editor" class="sim-field sim-program-editor" aria-label="Editable WorldSpec JSON" spellcheck="false"></textarea>
                      <div class="prompt-more-actions" aria-label="WorldSpec actions">
                        <button class="sim-action" id="apply-world-spec" type="button" disabled>Apply WorldSpec</button>
                        <button class="sim-action" id="replay-world-spec" type="button" disabled>Replay exact spec</button>
                        <button class="sim-action" id="reset-world-spec-edit" type="button">Discard edit</button>
                        <button class="sim-action" id="export-improvement-record" type="button" disabled>Export correction record</button>
                        <button class="sim-action" id="import-lab" type="button">Import</button>
                      </div>
                      <input id="world-spec-import-file" type="file" accept="application/json,.json" hidden>
                      <p id="world-spec-editor-status" class="world-spec-editor-status sim-status" data-state="idle" aria-live="polite">Open to inspect the executable program</p>
                      <p id="world-improvement-record-status" class="world-spec-editor-status sim-status" data-state="idle" aria-live="polite">Complete a failed-obligation edit and exact replay to create a record</p>
                    </div>
                  </details>
                  <details id="world-proof-panel" class="world-proof-panel">
                    <summary class="sim-action">Validation</summary>
                    <pre id="world-proof-preview" class="sim-code spec-preview world-proof-preview" tabindex="0">{}</pre>
                  </details>
            <details id="run-details-menu" class="run-details-menu">
              <summary class="sim-action">Run details</summary>
            <div id="intent-runtime" class="intent-runtime" data-state="idle" aria-live="polite">
              <div class="intent-runtime-head">
                <strong id="intent-runtime-title">Deterministic ready</strong>
                <span id="intent-runtime-percent" class="intent-runtime-percent">0%</span>
              </div>
