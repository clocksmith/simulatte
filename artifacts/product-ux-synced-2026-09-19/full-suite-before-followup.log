                <span id="intent-runtime-fill" class="intent-runtime-fill"></span>
              </div>
              <div class="intent-runtime-meta">
                <span id="intent-runtime-message">idle</span>
              </div>
              <span id="intent-runtime-stage" class="intent-runtime-detail">standby</span>
            </div>
    
              <aside class="phase-rail-shell" aria-label="Eight phase run status">
                <nav id="phase-rail" class="phase-rail" aria-label="Run phases"></nav>
                <p id="phase-details" class="phase-details" aria-live="polite"></p>
                <button id="copy-run-receipt" class="quiet-action sim-action" type="button">Copy run receipt</button>
              </aside>
            </details>
    
            <details id="prompt-more-menu" class="prompt-more-menu">
