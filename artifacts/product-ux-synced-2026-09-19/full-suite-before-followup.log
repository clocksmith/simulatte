              <div><dt>Alternative</dt><dd id="alternative-proof">Not planned</dd></div>
              <div><dt>Settled locally</dt><dd id="ledger-proof">0 trials</dd></div>
            </dl>
            <code id="route-formula">cost = travel + risk + preference</code>
            <div id="route-components" class="component-line"></div>
          </details>
    
    
          <details id="decision-section" class="evidence-section action-evidence">
            <summary>Decision</summary>
            <span class="sim-label">Candidate actions</span>
