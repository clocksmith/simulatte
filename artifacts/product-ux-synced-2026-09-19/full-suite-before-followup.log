            <span class="sim-label">Safety</span>
            <div id="gate-list" class="gate-list"></div>
            <span class="sim-label">Prediction check</span>
            <div id="settlement-math" class="settlement-math">No settled prediction</div>
          </details>
          <details id="advanced-section" class="evidence-section advanced-evidence">
            <summary>Advanced</summary>
            <details class="evidence-section retrieval-evidence">
              <summary>Place and feature matching <span id="retrieval-stats">No query</span></summary>
              <div class="pipeline-row"><span>Query</span><div id="retrieval-query">Waiting for observation</div></div>
              <div class="pipeline-row"><span>Found</span><div id="retrieval-candidates">No candidates</div></div>
              <div class="pipeline-row"><span>Ranked</span><div id="rerank-candidates">No ranking</div></div>
              <p id="reranker-proof" class="evidence-proof">Diagnostic comparison loading</p>
              <p id="place-resolution-proof" class="evidence-proof">Fast place matching</p>
            </details>
    
            <details class="evidence-section occurrence-evidence">
