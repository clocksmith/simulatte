    @import '../shared/design/themes/create.css';
    /* Create owns page layout; the compiler owns results and validation. */
    html, body { margin: 0; width: 100%; height: 100%; }
    body.create-app { overflow: hidden; }
    .create-header {
      position: sticky; top: 0; z-index: 30;
      height: 72px; display: flex; align-items: center; justify-content: space-between;
      padding: 0 84px 0 28px; gap: 16px; border-bottom: 1px solid var(--sim-line);
      background: var(--sim-glass);
    }
    .create-header .sim-product-nav { flex: 1; gap: 16px; }
    .create-header .create-brand { font: 600 25px var(--sim-heading); color: var(--sim-ink); padding: 0; letter-spacing: -1px; }
    .create-product { padding-left: 16px; border-left: 1px solid var(--sim-line); font-size: 14px; }
    .create-header .create-back { margin-left: auto; font-weight: 400; }
    .create-app > .sim-theme-control { top: 14px; right: 20px; }
    .physics-stage { display: grid; grid-template-columns: 360px minmax(0, 1fr); height: calc(100dvh - 72px); }
    .physics-stage[data-editor-hidden="true"] { grid-template-columns: minmax(0, 1fr); }
    .physics-panel { min-width: 0; overflow: auto; padding: 32px 26px 24px; border-right: 1px solid var(--sim-line); background: var(--sim-glass); }
    .prompt-dock-head { margin-bottom: 32px; }
    .create-eyebrow { font: 10px var(--sim-mono); letter-spacing: .11em; color: var(--sim-ink-faint); }
    .prompt-dock-head h1 { margin: 14px 0 12px; font: 600 34px/1.05 var(--sim-heading); letter-spacing: -.8px; }
    .prompt-dock-head > p:last-child { margin: 0; color: var(--sim-ink-soft); font-size: 14px; line-height: 1.6; max-width: 30ch; }
    .prompt-dock-core, .builder-row { display: grid; gap: 12px; min-width: 0; }
    .create-prompt-label { font-weight: 600; font-size: 13px; }
    #build-prompt { min-height: 132px; max-height: 260px; resize: vertical; font-size: 16px; line-height: 1.55; padding: 14px; background: var(--sim-paper); }
    .create-help { margin: -4px 0 0; color: var(--sim-ink-faint); font-size: 12px; line-height: 1.5; }
    .create-examples { display: flex; flex-wrap: wrap; gap: 6px; margin: 4px 0 8px; }
    .create-examples > span { flex-basis: 100%; font-size: 11px; color: var(--sim-ink-faint); margin-bottom: 2px; }
    .create-examples button { min-height: 44px; padding: 6px 9px; font-size: 12px; border: 1px solid var(--sim-line); background: transparent; color: var(--sim-ink); border-radius: var(--sim-radius-small); cursor: pointer; }
    .create-examples button:hover { border-color: var(--sim-ink); background: var(--sim-paper); }
    .prompt-actions { display: flex; flex-direction: column; gap: 8px; }
    #build-lab { min-height: 48px; background: var(--sim-ink); border-color: var(--sim-ink); color: var(--sim-paper); font-size: 14px; }
    #build-lab:hover:not(:disabled) { background: var(--sim-ink-soft); }
    #build-lab:disabled { opacity: .4; }
    #shuffle-prompt { border-color: transparent; background: transparent; font-weight: 400; font-size: 12px; }
    .prompt-action-icon { font-size: 18px; }
    .create-run-status { display: flex; align-items: baseline; gap: 10px; padding: 16px 0 4px; border-top: 1px solid var(--sim-line); }
    .create-status-dot { flex-shrink: 0; width: 6px; height: 6px; border-radius: 50%; background: var(--sim-ink-faint); }
    .create-run-status strong { font-size: 13px; font-weight: 600; }
    .create-run-status p { margin: 5px 0 0; color: var(--sim-ink-soft); font-size: 12px; line-height: 1.5; overflow-wrap: anywhere; }
    [data-create-state="error"] .create-run-status { color: var(--sim-red); }
    [data-create-state="warning"] .create-run-status { color: var(--sim-warning); }
    [data-create-state="running"] .create-status-dot { background: var(--sim-accent); animation: create-pulse 1.5s ease-in-out infinite; }
    .create-local-note { margin: 0 0 8px 16px; font-size: 11px; color: var(--sim-ink-faint); }
    .create-tools { border-top: 1px solid var(--sim-line); margin-top: 8px; }
    .create-tools > summary { min-height: 48px; padding: 16px 0; font-size: 12px; cursor: pointer; color: var(--sim-ink-soft); }
    .create-inspectors { display: grid; gap: 8px; }
    .create-inspectors > details > summary { min-height: 44px; width: 100%; justify-content: flex-start; text-align: left; box-shadow: none; font-weight: 500; }
    .create-tools .model-selection-panel { display: block; margin-bottom: 8px; padding: 0; border-radius: var(--sim-radius); }
    .create-tools .model-selection-panel > summary { padding: 12px; min-height: 44px; font-weight: 500; }
    .create-tools .model-selection-controls { position: static; min-width: 0; width: 100%; border: 0; box-shadow: none; }
    .create-tools .model-selection-row { grid-template-columns: 1fr; gap: 4px; }
    .create-preview { display: grid; grid-template-rows: 60px minmax(0, 1fr) 36px; min-width: 0; min-height: 0; padding: 0 24px 12px; }
    .create-preview-bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; font-size: 12px; color: var(--sim-ink-soft); }
    .create-preview-actions { display: flex; gap: 6px; }
    .create-preview-actions .sim-action { background: transparent; font-size: 12px; }
