      <section id="data-page" class="data-workbench-page" hidden>
        <header class="workbench-header">
          <div><h1>Your data</h1></div>
          <nav class="sim-product-nav" aria-label="Simulatte">
            <a href="#">Simulations</a>
            <a href="https://create.simulatte.world/" data-local-href="./blank/">Create</a>
          </nav>
        </header>
        <section id="data-workbench" aria-label="Data simulation workbench" data-state="idle">
          <ol class="workbench-steps" aria-label="Workflow"><li>Import</li><li>Prepare</li><li>Run</li><li>Edit</li><li>Export</li></ol>
          <p id="data-status" class="sim-status" role="status" aria-live="polite">Open CSV, JSON, or a saved program. Files stay on your device.</p>
          <div class="workbench-layout">
            <section class="workbench-input">
              <h2>Import</h2>
              <label for="data-input">Paste CSV or JSON</label>
              <textarea id="data-input" class="sim-input" rows="6" spellcheck="false" placeholder="id,x,y,vx,vy"></textarea>
              <div class="workbench-actions">
                <button id="data-read" class="sim-action" type="button">Read pasted data</button>
                <button id="data-sample" class="sim-action" type="button">Use example</button>
                <label class="sim-action workbench-file">Open file<input id="data-file" type="file" accept=".csv,.json,text/csv,application/json"></label>
              </div>
              <details><summary>Load from a URL</summary>
                <label for="data-url">Public HTTP(S) data URL</label>
                <input id="data-url" class="sim-input" type="url" placeholder="https://example.org/data.csv">
                <button id="data-fetch" class="sim-action" type="button">Fetch URL</button>
                <p>Fetch sends a request to this URL without credentials.</p>
              </details>
              <p id="data-source" class="workbench-identity"></p>
              <section id="data-prepare-panel" hidden>
                <h2>Prepare</h2>
                <div id="data-preview" class="workbench-table" tabindex="0" aria-label="Source preview"></div>
                <p>Choose position and velocity columns. Motion is constant; no forces or collisions.</p>
                <div class="workbench-fields">
                  <label>ID<select id="data-map-id" class="sim-input"></select></label>
                  <label>Label<select id="data-map-label" class="sim-input"></select></label>
                  <label>X position<select id="data-map-x" class="sim-input"></select></label>
                  <label>Y position<select id="data-map-y" class="sim-input"></select></label>
                  <label>X velocity<select id="data-map-vx" class="sim-input"></select></label>
                  <label>Y velocity<select id="data-map-vy" class="sim-input"></select></label>
                  <label>Coordinate units<input id="data-units" class="sim-input" value="units" maxlength="80"></label>
                  <label>Duration (seconds)<input id="data-duration" class="sim-input" type="number" min="0" max="3600" value="10"></label>
                  <label>Steps<input id="data-steps" class="sim-input" type="number" min="1" max="600" value="60"></label>
                </div>
                <button id="data-prepare" class="sim-action" type="button">Prepare program</button>
              </section>
            </section>
            <section class="workbench-execution">
              <h2>Run and inspect</h2>
              <div class="workbench-actions">
                <button id="data-run" class="sim-action" type="button" disabled>Run</button>
                <button id="data-cancel" class="sim-action" type="button" disabled>Cancel</button>
                <button id="data-replay" class="sim-action" type="button" disabled>Replay</button>
                <button id="data-export" class="sim-action" type="button" disabled>Export program</button>
                <button id="data-export-result" class="sim-action" type="button" disabled>Export result</button>
              </div>
              <section id="data-result" hidden>
                <canvas id="data-canvas" width="800" height="500" aria-label="2D data points; equivalent coordinates appear in the output table"></canvas>
                <label for="data-step">Inspect simulation step</label>
                <input id="data-step" type="range" min="0" max="60" step="1" value="0" disabled>
                <p id="data-time"></p><p id="data-selection" aria-live="polite">Select a point to inspect its coordinates.</p>
                <p id="data-comparison"></p>
                <div id="data-output" class="workbench-table" tabindex="0" aria-label="Output points, first 20"></div>
                <details><summary>Execution evidence</summary><pre id="data-evidence" class="sim-code"></pre></details>
              </section>
              <section id="data-program" hidden>
                <h2>Edit the program</h2>
                <p>Apply your changes, then run.</p>
                <label for="data-editor">WorldSpec JSON</label>
                <textarea id="data-editor" class="sim-input sim-code" rows="14" spellcheck="false"></textarea>
                <div class="workbench-actions">
                  <button id="data-apply" class="sim-action" type="button" disabled>Apply edit</button>
                  <button id="data-reset" class="sim-action" type="button">Discard changes</button>
                </div>
                <p id="data-edit-status" class="sim-status" aria-live="polite"></p>
              </section>
            </section>
          </div>
        </section>
        </section>
      </div>
    </body>
    </html>
    
