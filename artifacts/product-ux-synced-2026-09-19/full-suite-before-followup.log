              <button id="reset-profile-world-spec" class="sim-action" type="button">Discard edit</button>
              <button id="replay-profile-world-spec" class="sim-action" type="button" disabled>Replay exact spec</button>
              <button id="export-profile-world-spec" class="sim-action" type="button">Export</button>
              <button id="import-profile-world-spec" class="sim-action" type="button">Import</button>
              <input id="profile-world-spec-import-file" type="file" accept="application/json,.json" hidden>
            </div>
            <details class="profile-world-proof-details">
              <summary id="profile-world-proof-status" class="sim-status" data-state="pending">WorldProof waits for a settled run</summary>
