    @import '../shared/design/themes/create.css';
    /* Create owns page layout; the compiler owns results and validation. */
    html, body { margin: 0; width: 100%; height: 100%; }
    body.create-app { overflow: hidden; }
    .create-header {
      position: sticky; top: 0; z-index: 30;
      height: 72px; display: flex; align-items: center; justify-content: space-between;
      padding: 0 84px 0 28px; gap: 16px; border-bottom: 1px solid var(--sim-line);
      background: var(--sim-glass);
    }
    .create-header .sim-product-nav { flex: 1; gap: 16px; }
    .create-header .create-brand { font: 600 25px var(--sim-heading); color: var(--sim-ink); padding: 0; letter-spacing: -1px; }
    .create-product { padding-left: 16px; border-left: 1px solid var(--sim-line); font-size: 14px; }
    .create-header .create-back { margin-left: auto; font-weight: 400; }
    .create-app > .sim-theme-control { top: 14px; right: 20px; }
    .physics-stage { display: grid; grid-template-columns: 360px minmax(0, 1fr); height: calc(100dvh - 72px); }
    .physics-stage[data-editor-hidden="true"] { grid-template-columns: minmax(0, 1fr); }
    .physics-panel { min-width: 0; overflow: auto; padding: 32px 26px 24px; border-right: 1px solid var(--sim-line); background: var(--sim-glass); }
    .prompt-dock-head { margin-bottom: 32px; }
    .create-eyebrow { font: 10px var(--sim-mono); letter-spacing: .11em; color: var(--sim-ink-faint); }
    .prompt-dock-head h1 { margin: 14px 0 12px; font: 600 34px/1.05 var(--sim-heading); letter-spacing: -.8px; }
    .prompt-dock-head > p:last-child { margin: 0; color: var(--sim-ink-soft); font-size: 14px; line-height: 1.6; max-width: 30ch; }
    .prompt-dock-core, .builder-row { display: grid; gap: 12px; min-width: 0; }
    .create-prompt-label { font-weight: 600; font-size: 13px; }
    #build-prompt { min-height: 132px; max-height: 260px; resize: vertical; font-size: 16px; line-height: 1.55; padding: 14px; background: var(--sim-paper); }
    .create-help { margin: -4px 0 0; color: var(--sim-ink-faint); font-size: 12px; line-height: 1.5; }
    .create-examples { display: flex; flex-wrap: wrap; gap: 6px; margin: 4px 0 8px; }
    .create-examples > span { flex-basis: 100%; font-size: 11px; color: var(--sim-ink-faint); margin-bottom: 2px; }
    .create-examples button { min-height: 44px; padding: 6px 9px; font-size: 12px; border: 1px solid var(--sim-line); background: transparent; color: var(--sim-ink); border-radius: var(--sim-radius-small); cursor: pointer; }
    .create-examples button:hover { border-color: var(--sim-ink); background: var(--sim-paper); }
    .prompt-actions { display: flex; flex-direction: column; gap: 8px; }
    #build-lab { min-height: 48px; background: var(--sim-ink); border-color: var(--sim-ink); color: var(--sim-paper); font-size: 14px; }
    #build-lab:hover:not(:disabled) { background: var(--sim-ink-soft); }
    #build-lab:disabled { opacity: .4; }
    #shuffle-prompt { border-color: transparent; background: transparent; font-weight: 400; font-size: 12px; }
    .prompt-action-icon { font-size: 18px; }
    .create-run-status { display: flex; align-items: baseline; gap: 10px; padding: 16px 0 4px; border-top: 1px solid var(--sim-line); }
    .create-status-dot { flex-shrink: 0; width: 6px; height: 6px; border-radius: 50%; background: var(--sim-ink-faint); }
    .create-run-status strong { font-size: 13px; font-weight: 600; }
    .create-run-status p { margin: 5px 0 0; color: var(--sim-ink-soft); font-size: 12px; line-height: 1.5; overflow-wrap: anywhere; }
    [data-create-state="error"] .create-run-status { color: var(--sim-red); }
    [data-create-state="warning"] .create-run-status { color: var(--sim-warning); }
    [data-create-state="running"] .create-status-dot { background: var(--sim-accent); animation: create-pulse 1.5s ease-in-out infinite; }
    .create-local-note { margin: 0 0 8px 16px; font-size: 11px; color: var(--sim-ink-faint); }
    .create-tools { border-top: 1px solid var(--sim-line); margin-top: 8px; }
    .create-tools > summary { min-height: 48px; padding: 16px 0; font-size: 12px; cursor: pointer; color: var(--sim-ink-soft); }
    .create-inspectors { display: grid; gap: 8px; }
    .create-inspectors > details > summary { min-height: 44px; width: 100%; justify-content: flex-start; text-align: left; box-shadow: none; font-weight: 500; }
    .create-tools .model-selection-panel { display: block; margin-bottom: 8px; padding: 0; border-radius: var(--sim-radius); }
    .create-tools .model-selection-panel > summary { padding: 12px; min-height: 44px; font-weight: 500; }
    .create-tools .model-selection-controls { position: static; min-width: 0; width: 100%; border: 0; box-shadow: none; }
    .create-tools .model-selection-row { grid-template-columns: 1fr; gap: 4px; }
    .create-preview { display: grid; grid-template-rows: 60px minmax(0, 1fr) 36px; min-width: 0; min-height: 0; padding: 0 24px 12px; }
    .create-preview-bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; font-size: 12px; color: var(--sim-ink-soft); }
    .create-preview-actions { display: flex; gap: 6px; }
    .create-preview-actions .sim-action { background: transparent; font-size: 12px; }
    .physics-canvas-wrap { position: relative; width: 100%; height: 100%; min-height: 0; container-type: size; border: 1px solid var(--sim-line); background-image: linear-gradient(var(--sim-lattice) 1px, transparent 1px), linear-gradient(90deg, var(--sim-lattice) 1px, transparent 1px); background-size: 40px 40px; }
    #physics-canvas, #loading-canvas { position: absolute; inset: 0; margin: auto; display: block; width: min(100cqw, 100cqh); height: min(100cqw, 100cqh); }
    #physics-canvas[data-scene-visible="false"] { opacity: 0; visibility: hidden; }
    #physics-canvas[data-interaction-selected-target]:not([data-interaction-selected-target=""]) { cursor: grab; }
    #physics-canvas[data-interaction-grabbed-target]:not([data-interaction-grabbed-target=""]) { cursor: grabbing; }
    #loading-canvas { z-index: 8; pointer-events: none; opacity: 0; }
    #loading-canvas.is-active { opacity: 1; }
    .create-empty { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; flex-direction: column; text-align: center; padding: 24px; }
    .create-empty-mark { color: var(--sim-line-strong); font: 300 48px var(--sim-mono); margin-bottom: 12px; }
    .create-empty h2 { margin: 0; font: 600 28px/1.2 var(--sim-heading); letter-spacing: -.5px; }
    .create-empty p { color: var(--sim-ink-soft); font-size: 13px; max-width: 32ch; line-height: 1.6; }
    .create-interaction-hint { margin: 10px 0 0; font-size: 11px; color: var(--sim-ink-faint); text-align: center; }
    .intent-runtime { margin-top: 12px; font-size: 12px; }
    .intent-runtime-head { display: flex; justify-content: space-between; gap: 10px; }
    .intent-runtime-track { height: 3px; background: var(--sim-line); margin: 6px 0; }
    .intent-runtime-fill { display: block; height: 100%; width: 0; background: var(--sim-ink); }
    .intent-runtime-meta, .intent-runtime-detail { color: var(--sim-ink-soft); font-size: 11px; overflow-wrap: anywhere; }
    @keyframes create-pulse { 50% { opacity: .3; } }
    .world-spec-editor-controls,
    .prompt-more-content {
      display: grid;
      gap: 8px;
      padding-top: 12px;
    }
    .prompt-more-actions,
    .prompt-corner-controls {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }
    .prompt-more-section-title {
      color: var(--sim-ink-faint);
      font-size: 12px;
    }
    .prompt-more-runtime,
    .world-model-head {
      display: flex;
      justify-content: space-between;
      gap: 12px;
    }
    .world-model-panel {
      display: grid;
      gap: 8px;
      padding-top: 12px;
    }
    .world-model-summary,
    .world-model-status,
    .physics-status,
    .physics-fps {
      color: var(--sim-ink-soft);
      font-size: 11px;
      overflow-wrap: anywhere;
    }
    .world-model-chips {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 6px;
    }
    .world-model-chip {
      min-width: 0;
    }
    .world-model-chip span,
    .world-model-chip strong {
      display: block;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .world-model-chip span {
      color: var(--sim-ink-faint);
      font-size: 11px;
    }
    .phase-rail-shell {
      padding-top: 12px;
    }
    .phase-rail {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 6px;
    }
    .phase-rail-step {
      min-width: 0;
      min-height: 44px;
      padding: 6px;
      border: 1px solid var(--sim-line);
      border-radius: var(--sim-radius);
      background: var(--sim-glass-soft);
      color: var(--sim-ink-soft);
      font-size: 11px;
      cursor: pointer;
    }
    .phase-rail-step[data-status="running"] {
      border-color: var(--sim-accent);
    }
    .phase-rail-step[data-status="passed"] {
      color: var(--sim-accent);
    }
    .phase-rail-step[data-status="failed"] {
      color: var(--sim-red);
    }
    .phase-rail-step:is([data-status="not-proven"], [data-status="unsupported"]) {
      color: var(--sim-warning);
      border-style: dashed;
    }
    .phase-details {
      color: var(--sim-ink-soft);
      font-size: 11px;
      overflow-wrap: anywhere;
    }
    .world-spec-reconciliation-detail ol {
      display: grid;
      gap: 8px;
      max-height: 180px;
      overflow: auto;
      padding-left: 24px;
    }
    .world-spec-reconciliation-detail code,
    .world-spec-reconciliation-detail span {
      display: block;
      overflow-wrap: anywhere;
    }
    .world-spec-reconciliation-conflicts[data-state="error"] {
      color: var(--sim-red);
    }
    .world-spec-reconciliation-conflicts[data-state="conflict"] {
      color: var(--sim-warning);
    }
    .simulatte-review-bridge {
      position: fixed;
      z-index: 55;
      top: 12px;
      right: 12px;
      width: min(440px, calc(100vw - 24px));
      max-height: calc(100dvh - 24px);
      display: grid;
      gap: 10px;
      overflow: auto;
      padding: 12px;
      border: 1px solid var(--sim-line);
      border-radius: var(--sim-radius-large);
      background: var(--sim-glass);
      color: var(--sim-ink);
      box-shadow: var(--sim-shadow);
    }
    .training-layer-head,
    .training-head-actions,
    .training-utility-row {
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .training-layer-head {
      justify-content: space-between;
    }
    .training-title-block,
    .training-layer-body {
      display: grid;
      gap: 8px;
    }
    .simulatte-review-bridge.is-collapsed {
      width: min(280px, calc(100vw - 24px));
    }
    .simulatte-review-bridge.is-collapsed .training-layer-body {
      display: none;
    }
    .training-prompt-readout {
      display: grid;
      gap: 4px;
      border-bottom: 1px solid var(--sim-line);
      padding-bottom: 8px;
    }
    .training-prompt-readout output,
    .training-artifact-summary {
      max-height: 60px;
      overflow: auto;
    }
    .training-field-label,
    .training-note-label,
    .training-phase-name,
    .training-phase-state,
    .training-utility-row span {
      color: var(--sim-ink-soft);
      font-size: 11px;
    }
    .training-artifact-json {
      max-height: 150px;
      overflow: auto;
      color: var(--sim-ink-soft);
      font: 11px/1.5 var(--sim-mono);
      white-space: pre-wrap;
      overflow-wrap: anywhere;
    }
    .training-utility-row {
      flex-wrap: wrap;
    }
    .training-primary-actions,
    .training-phase-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 6px;
    }
    .simulatte-review-bridge button {
      min-height: 44px;
      padding: 8px;
      border: 1px solid var(--sim-line);
      border-radius: var(--sim-radius);
      color: var(--sim-ink);
      background: var(--sim-glass-soft);
      cursor: pointer;
    }
    .training-phase-grid button {
      display: grid;
      gap: 2px;
      text-align: left;
    }
    .training-phase-grid button.is-active {
      border-color: var(--sim-accent);
    }
    .training-phase-grid button[data-phase-state="missing"] {
      color: var(--sim-warning);
    }
    .simulatte-review-bridge textarea {
      width: 100%;
      min-height: 66px;
      max-height: 140px;
      resize: vertical;
      padding: 8px;
      border: 1px solid var(--sim-line);
      border-radius: var(--sim-radius);
      background: var(--sim-paper);
      color: var(--sim-ink);
    }
    @media (max-width: 1050px) and (min-width: 761px) {
      .physics-stage { grid-template-columns: 320px minmax(0, 1fr); }
      .physics-panel { padding: 24px 20px; }
      .create-header .create-back { display: none; }
    }
    @media (max-width: 760px) {
      body.create-app { overflow: auto; }
      .create-header { height: 64px; padding: 0 68px 0 16px; gap: 8px; }
