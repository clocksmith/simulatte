                </details></details>
          <a id="experience-doc-link" class="sim-text-link experience-doc-link" target="_blank" rel="noopener noreferrer" hidden>Experience docs</a>
    
          <details id="profile-program-section" class="evidence-section profile-program-section">
            <summary>World program <span id="profile-world-spec-status" class="sim-status">Loading WorldSpec</span></summary>
            <label class="profile-program-editor-label" for="profile-world-spec-editor">
              <span class="sim-label">Editable WorldSpec</span>
              <textarea id="profile-world-spec-editor" class="sim-field sim-program-editor" spellcheck="false" aria-describedby="profile-world-spec-status"></textarea>
            </label>
            <p class="evidence-proof">Profile packs currently accept a governed scenario selection at <code>/params/scenarioId</code>. Other edits fail closed until their runtime contract is executable.</p>
            <div class="receipt-actions profile-program-actions">
              <button id="apply-profile-world-spec" class="sim-action" type="button" disabled>Apply WorldSpec</button>
              <button id="reset-profile-world-spec" class="sim-action" type="button">Discard edit</button>
              <button id="replay-profile-world-spec" class="sim-action" type="button" disabled>Replay exact spec</button>
              <button id="export-profile-world-spec" class="sim-action" type="button">Export</button>
              <button id="import-profile-world-spec" class="sim-action" type="button">Import</button>
              <input id="profile-world-spec-import-file" type="file" accept="application/json,.json" hidden>
            </div>
            <details class="profile-world-proof-details">
              <summary id="profile-world-proof-status" class="sim-status" data-state="pending">WorldProof waits for a settled run</summary>
              <pre id="profile-world-proof" class="profile-world-proof sim-code" aria-live="polite"></pre>
            </details>
          </details>
    
          <details id="journey-section" class="evidence-section journey-evidence" open>
            <summary>Journey <span id="route-stats">Not planned</span></summary>
            <dl class="journey-facts">
              <div><dt>Forecast</dt><dd id="planning-forecast">Not planned</dd></div>
              <div><dt>Alternative</dt><dd id="alternative-proof">Not planned</dd></div>
              <div><dt>Settled locally</dt><dd id="ledger-proof">0 trials</dd></div>
            </dl>
            <code id="route-formula">cost = travel + risk + preference</code>
            <div id="route-components" class="component-line"></div>
          </details>
    
    
          <details id="decision-section" class="evidence-section action-evidence">
            <summary>Decision</summary>
            <span class="sim-label">Candidate actions</span>
            <div id="bet-list" class="bet-list" aria-label="Candidate actions"></div>
            <span class="sim-label">Safety</span>
            <div id="gate-list" class="gate-list"></div>
            <span class="sim-label">Prediction check</span>
            <div id="settlement-math" class="settlement-math">No settled prediction</div>
          </details>
          <details id="advanced-section" class="evidence-section advanced-evidence">
            <summary>Advanced</summary>
            <details class="evidence-section retrieval-evidence">
              <summary>Place and feature matching <span id="retrieval-stats">No query</span></summary>
              <div class="pipeline-row"><span>Query</span><div id="retrieval-query">Waiting for observation</div></div>
              <div class="pipeline-row"><span>Found</span><div id="retrieval-candidates">No candidates</div></div>
              <div class="pipeline-row"><span>Ranked</span><div id="rerank-candidates">No ranking</div></div>
              <p id="reranker-proof" class="evidence-proof">Diagnostic comparison loading</p>
              <p id="place-resolution-proof" class="evidence-proof">Fast place matching</p>
            </details>
    
            <details class="evidence-section occurrence-evidence">
              <summary>World events <span id="occurrence-stats">No patterns evaluated</span></summary>
              <div class="pipeline-row"><span>Active</span><div id="occurrence-patterns">No active pattern</div></div>
              <div class="pipeline-row"><span>Effects</span><div id="occurrence-effects">No world effect</div></div>
            </details>
    
            <details class="evidence-section policy-evidence">
              <summary>Policy arena</summary>
              <p id="policy-arena-proof" class="evidence-proof">Loading evidence</p>
            </details>
    
            <details class="evidence-section receipt-evidence">
              <summary>Receipts</summary>
              <div class="receipt-actions">
                <button id="export-button" class="sim-action" type="button" disabled>Export journey</button>
                <button id="export-ledger-button" class="sim-action" type="button">Export ledger</button>
                <button id="import-receipt-button" class="sim-action" type="button">Import</button>
                <input id="import-receipt-file" type="file" accept="application/json,.json" hidden>
              </div>
              <div id="trace-list" class="trace-list" aria-live="polite"></div>
            </details>
          </details>
        </aside>
      </main>
    
      <dialog id="neural-model-dialog" class="neural-consent-dialog" aria-labelledby="neural-model-title">
        <div class="neural-consent-body">
