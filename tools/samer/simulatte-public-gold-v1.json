  "promotionHoldout": {
    "sealed": true,
    "promptTextIncluded": false,
    "requiredFamilies": [
      "animals",
      "people",
      "vehicles",
      "structures",
      "furniture",
      "tools",
      "environments",
      "unseen-composites"
    ]
