      "extractionRequirements": [
        { "id": "entity-excavator", "kind": "entity", "targetIds": ["entity:excavator"], "polarity": "required" },
        { "id": "entity-greenhouse", "kind": "entity", "targetIds": ["entity:greenhouse"], "polarity": "required" },
        { "id": "attribute-yellow-excavator", "kind": "attribute", "targetIds": ["entity:excavator"], "predicateAny": ["color"], "value": "#f4d03f" },
        { "id": "material-glass-greenhouse", "kind": "relation", "targetIds": ["entity:greenhouse", "medium:glass"], "predicateAny": ["material-of"] },
