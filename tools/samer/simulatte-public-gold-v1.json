        { "type": "violin", "kind": "color", "value": "#8055b8" },
        { "type": "chair", "kind": "material", "value": "wood" }
      ],
      "extractionRequirements": [
        { "id": "entity-violin", "kind": "entity", "targetIds": ["entity:violin"], "polarity": "required" },
        { "id": "entity-stool", "kind": "entity", "targetIds": ["entity:stool"], "polarity": "required" },
        { "id": "attribute-purple-violin", "kind": "attribute", "targetIds": ["entity:violin"], "predicateAny": ["color"], "value": "#8055b8" },
        { "id": "attribute-wooden-stool", "kind": "attribute", "targetIds": ["entity:stool"], "predicateAny": ["material"], "value": "wood" },
        { "id": "relation-violin-on-stool", "kind": "relation", "targetIds": ["entity:violin", "entity:stool"], "predicateAny": ["on"] }
      ],
      "blockingVisualRules": ["recognizable-violin", "recognizable-stool", "purple-violin", "wooden-stool", "violin-on-stool", "not-generic-box-only"]
    },
    {
      "id": "excavator-beside-greenhouse",
      "difficulty": "medium",
      "difficultyBasis": "Specialized objects with color, material, and side-by-side layout.",
      "prompt": "yellow excavator beside a glass greenhouse",
      "entities": [
        { "type": "excavator", "count": 1 },
        { "type": "greenhouse", "count": 1 }
