{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simulatte.world/contracts/recursive-world-proof.schema.json",
  "title": "Simulatte Recursive World Proof",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "worldSpecContentHash",
    "sceneContentHash",
    "executionPlanHash",
    "coordinatorId",
    "buildId",
    "runtimeId",
    "deviceClass",
    "qualificationLaneId",
    "browserMode",
    "baselineObservationContentHash",
    "terminalObservationContentHash",
    "terminalLogicalTime",
    "ledgerEntryHashes",
    "frameReceiptHashes",
    "causalSettlements",
    "proofClasses",
    "verdict",
    "contentHash"
  ],
  "properties": {
    "schema": { "const": "simulatte.recursive-world-proof/v1" },
    "worldSpecContentHash": { "type": "string", "minLength": 1 },
    "sceneContentHash": { "type": "string", "minLength": 1 },
    "executionPlanHash": { "type": "string", "minLength": 1 },
    "coordinatorId": { "type": "string", "minLength": 1 },
    "buildId": { "type": "string", "minLength": 1 },
    "runtimeId": { "type": "string", "minLength": 1 },
    "deviceClass": { "type": "string", "minLength": 1 },
    "qualificationLaneId": { "type": "string", "minLength": 1 },
    "browserMode": { "type": "string", "minLength": 1 },
    "baselineObservationContentHash": { "type": "string", "minLength": 1 },
    "terminalObservationContentHash": { "type": "string", "minLength": 1 },
    "terminalLogicalTime": { "type": "number" },
    "ledgerEntryHashes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "frameReceiptHashes": { "type": "array", "items": { "type": "string" } },
    "causalSettlements": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/causalSettlement" } },
    "proofClasses": {
      "type": "object",
      "additionalProperties": false,
      "required": ["composition", "simulation", "residency", "worker-parity", "visual", "performance", "replay"],
      "properties": {
        "composition": { "$ref": "#/$defs/proofClass" },
        "simulation": { "$ref": "#/$defs/proofClass" },
        "residency": { "$ref": "#/$defs/proofClass" },
        "worker-parity": { "$ref": "#/$defs/proofClass" },
        "visual": { "$ref": "#/$defs/proofClass" },
        "performance": { "$ref": "#/$defs/proofClass" },
        "replay": { "$ref": "#/$defs/proofClass" }
      }
    },
    "verdict": { "enum": ["pass", "fail", "not-proven"] },
    "contentHash": { "type": "string", "pattern": "^fnv1a32:[0-9a-f]{8}$" }
  },
  "$defs": {
    "causalSettlement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "sourcePortId", "comparison", "baselineValue", "terminalValue", "unit", "status"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "sourcePortId": { "type": "string", "minLength": 1 },
            "comparison": { "enum": ["decreases", "increases", "equals"] },
            "baselineValue": { "type": "number" },
            "terminalValue": { "type": "number" },
            "unit": { "type": ["string", "null"] },
            "status": { "enum": ["pass", "fail"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "sourcePortId", "status", "reason"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "sourcePortId": { "type": "string", "minLength": 1 },
            "status": { "const": "fail" },
            "reason": { "type": "string", "minLength": 1 }
          }
        }
      ]
    },
    "proofClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence", "failures"],
      "properties": {
        "status": { "enum": ["pass", "fail", "not-proven"] },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "failures": { "type": "array", "items": { "type": "string" } }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "pass" } }, "required": ["status"] },
          "then": { "properties": { "evidence": { "minItems": 1 } } }
        }
      ]
    }
  }
}
