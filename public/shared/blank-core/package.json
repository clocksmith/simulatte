      "types": "./compiler.d.ts",
      "import": "./compiler.js"
    },
    "./world": {
      "types": "./world.d.ts",
      "import": "./world.js"
    },
    "./data": {
      "types": "./data.d.ts",
      "import": "./data.js"
    },
    "./render": {
      "types": "./render.d.ts",
      "import": "./render.js"
    },
