  },
  "files": [
    "index.js",
    "index.d.ts",
    "runtime.js",
    "contracts.js",
    "compiler.js",
    "compiler.d.ts",
    "world.js",
    "world.d.ts",
    "data.js",
    "data.d.ts",
    "render.js",
    "render.d.ts",
    "factories/",
    "compat/",
