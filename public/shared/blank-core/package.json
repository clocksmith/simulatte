{
  "name": "@simulatte/blank-core",
  "version": "0.1.0",
  "description": "Shared simulation contracts and plugin execution, independent of product UI.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
