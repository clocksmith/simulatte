{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simulatte.plugin.gpuSuperclusterConfig.schema.json",
  "title": "GpuSuperclusterConfig",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "totalGpus",
    "racks",
    "collectiveAlgorithm",
    "parallelism"
  ],
  "properties": {
    "schema": { "type": "string", "const": "simulatte.plugin.gpuSuperclusterConfig.v1" },
    "id": { "type": "string" },
    "seed": { "type": "string" },
    "totalGpus": { "type": "integer", "minimum": 8, "maximum": 1024 },
    "racks": { "type": "integer", "minimum": 1, "maximum": 128 },
    "nodesPerRack": { "type": "integer", "minimum": 1, "maximum": 16 },
    "gpusPerNode": { "type": "integer", "minimum": 1, "maximum": 16 },
    "parallelism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tensorParallel", "pipelineParallel", "dataParallel"],
      "properties": {
        "tensorParallel": { "type": "integer", "minimum": 1, "maximum": 16 },
        "pipelineParallel": { "type": "integer", "minimum": 1, "maximum": 64 },
        "dataParallel": { "type": "integer", "minimum": 1, "maximum": 128 }
      }
    },
    "collectiveAlgorithm": {
      "type": "string",
      "enum": ["ring-allreduce", "tree-allreduce", "2d-torus-all-to-all"]
    },
    "tensorSizeGb": { "type": "number", "minimum": 0.1, "maximum": 1000 },
    "nvlinkBandwidthGbps": { "type": "number", "minimum": 100, "maximum": 3600 },
    "infinibandBandwidthGbps": { "type": "number", "minimum": 100, "maximum": 3200 },
    "coolantInletTempC": { "type": "number", "minimum": 5, "maximum": 45 },
    "coolantFlowLpm": { "type": "number", "minimum": 10, "maximum": 1000 },
    "ambientAirTempC": { "type": "number", "minimum": 10, "maximum": 50 },
    "gpuTdpW": { "type": "number", "minimum": 100, "maximum": 2000 },
    "stragglerNodeId": { "type": ["string", "null"] },
    "stragglerThrottlePercent": { "type": "number", "minimum": 0, "maximum": 95 },
    "linkPacketDropRate": { "type": "number", "minimum": 0, "maximum": 0.5 },
    "cduFlowDegradationPercent": { "type": "number", "minimum": 0, "maximum": 90 }
  }
}
