{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Interstellar Relay Network configuration",
  "type": "object",
  "required": [
    "schema",
    "id",
    "defaultTransceiver",
    "defaultScenarioId",
    "processingDelayHours",
    "startEpochIso",
    "targetEpochYear"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "simulatte.plugin.interstellarRelayConfig.v2"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "defaultTransceiver": {
      "type": "string",
      "minLength": 1
    },
    "defaultScenarioId": {
      "type": "string",
      "minLength": 1
    },
    "processingDelayHours": {
      "type": "number",
      "minimum": 0,
      "maximum": 8760
    },
    "startEpochIso": {
      "type": "string",
      "format": "date-time"
    },
    "targetEpochYear": {
      "type": "number",
      "minimum": 2016,
      "maximum": 2200
    }
  }
}
