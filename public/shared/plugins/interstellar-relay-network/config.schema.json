{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Interstellar Relay Network configuration",
  "type": "object",
  "required": [
    "schema",
    "id",
    "defaultTransceiver",
    "defaultScenarioId",
    "defaultRoutingMode",
    "defaultRouteObjective",
    "defaultChannelMode",
    "defaultOperationsProfileId",
    "maxHops",
    "maxHopDistancePc",
    "ensembleSize",
    "processingDelayHours",
    "startEpochIso"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "simulatte.plugin.interstellarRelayConfig.v2"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "defaultTransceiver": {
      "type": "string",
      "minLength": 1
    },
    "defaultScenarioId": {
      "type": "string",
      "minLength": 1
    },
    "defaultRoutingMode": {
      "enum": [
        "direct",
        "automatic",
        "manual"
      ]
    },
    "defaultRouteObjective": {
      "enum": [
        "latency",
        "throughput",
        "energy",
        "reliability",
        "balanced"
      ]
    },
    "defaultChannelMode": {
      "enum": [
        "classical-optical",
        "quantum-assisted",
        "traversable-wormhole",
        "alcubierre-warp"
      ]
    },
    "defaultOperationsProfileId": {
      "type": "string",
      "minLength": 1
    },
    "maxHops": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "maxHopDistancePc": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 250000
    },
    "ensembleSize": {
      "type": "integer",
      "minimum": 8,
      "maximum": 512
    },
    "processingDelayHours": {
      "type": "number",
      "minimum": 0,
      "maximum": 8760
    },
    "startEpochIso": {
      "type": "string",
      "format": "date-time"
    }
  }
}
