{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cable Trader logistics configuration v5",
  "type": "object",
  "required": ["schema", "id", "cableTypes", "hubs", "demandSites", "scenarioModifiers", "simulation"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "simulatte.plugin.cableTraderConfig.v5" },
    "id": { "type": "string", "minLength": 1 },
    "cableTypes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["id", "label", "shortLabel", "conductor", "reelLengthM", "minimumUsefulRemnantM", "modeledCostPerMeter", "demandWeight", "substitutesFor"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "shortLabel": { "type": "string", "minLength": 1 },
          "conductor": { "type": "string", "minLength": 1 },
          "reelLengthM": { "type": "integer", "minimum": 20, "maximum": 5000 },
          "minimumUsefulRemnantM": { "type": "integer", "minimum": 1, "maximum": 500 },
          "modeledCostPerMeter": { "type": "number", "exclusiveMinimum": 0 },
          "demandWeight": { "type": "number", "exclusiveMinimum": 0 },
          "substitutesFor": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "hubs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/place" }
    },
    "demandSites": {
      "type": "array",
      "minItems": 2,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["id", "label", "nodeId", "defaultPriority"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "nodeId": { "type": "string", "minLength": 1 },
          "defaultPriority": { "enum": ["critical", "urgent", "standard"] }
        }
      }
    },
    "scenarioModifiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "demandTypeMultipliers", "demandSiteMultipliers"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "demandTypeMultipliers": { "type": "object", "additionalProperties": { "type": "number", "exclusiveMinimum": 0 } },
          "demandSiteMultipliers": { "type": "object", "additionalProperties": { "type": "number", "exclusiveMinimum": 0 } }
        }
      }
    },
    "simulation": {
      "type": "object",
      "required": [
        "seed", "selectedCableFamilyIds", "ensembleSeeds", "durationDays", "needCount",
        "returnCount", "journeyEventCount", "renderedRequestCount", "initialInventoryPerHubType",
        "demandPriority", "allowSubstitutes", "reservePolicy", "transferCapacityMetersPerDay",
        "allocationObjective", "fairnessWeight", "disruptionScenario"
      ],
      "additionalProperties": false,
      "properties": {
        "seed": { "type": "string", "minLength": 1 },
        "selectedCableFamilyIds": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "ensembleSeeds": { "type": "array", "minItems": 2, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "durationDays": { "type": "integer", "minimum": 6, "maximum": 60 },
        "needCount": { "type": "integer", "minimum": 6, "maximum": 200 },
        "returnCount": { "const": 0 },
        "journeyEventCount": { "const": 0 },
        "renderedRequestCount": { "type": "integer", "minimum": 1, "maximum": 64 },
        "initialInventoryPerHubType": { "type": "integer", "minimum": 1, "maximum": 12 },
        "demandPriority": { "enum": ["critical-first", "deadline-first", "balanced"] },
        "allowSubstitutes": { "type": "boolean" },
        "reservePolicy": { "enum": ["none", "one-reel", "twenty-percent"] },
        "transferCapacityMetersPerDay": { "type": "integer", "minimum": 50, "maximum": 10000 },
        "allocationObjective": { "enum": ["cheapest", "fastest", "fairness-first"] },
        "fairnessWeight": { "type": "number", "minimum": 0, "maximum": 5 },
        "disruptionScenario": { "enum": ["none", "road-closure", "damaged-stock", "surprise-demand", "fairness-conflict"] }
      }
    }
  },
  "$defs": {
    "place": {
      "type": "object",
      "required": ["id", "label", "nodeId"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "nodeId": { "type": "string", "minLength": 1 }
      }
    }
  }
}
