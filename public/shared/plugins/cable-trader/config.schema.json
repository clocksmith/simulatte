{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cable Trader circulation configuration v6",
  "type": "object",
  "required": ["schema", "id", "cableTypes", "hubs", "locations", "simulation"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "simulatte.plugin.cableTraderConfig.v6" },
    "id": { "type": "string", "minLength": 1 },
    "cableTypes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 24,
      "items": {
        "type": "object",
        "required": ["id", "label", "shortLabel", "tone", "demandWeight", "supplyWeight"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "shortLabel": { "type": "string", "minLength": 1 },
          "tone": { "type": "string", "minLength": 1 },
          "demandWeight": { "type": "number", "exclusiveMinimum": 0 },
          "supplyWeight": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "hubs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/place" }
    },
    "locations": {
      "type": "array",
      "minItems": 4,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/place" }
    },
    "simulation": {
      "type": "object",
      "required": [
        "seed",
        "durationDays",
        "peopleCount",
        "hubCount",
        "locationCount",
        "selectedCableTypeIds",
        "initialInventoryPerHubCable",
        "dailyParticipationRate",
        "renderedTravelerCount"
      ],
      "additionalProperties": false,
      "properties": {
        "seed": { "type": "string", "minLength": 1 },
        "durationDays": { "const": 365 },
        "peopleCount": { "type": "integer", "minimum": 1000, "maximum": 25000 },
        "hubCount": { "type": "integer", "minimum": 2, "maximum": 12 },
        "locationCount": { "type": "integer", "minimum": 4, "maximum": 32 },
        "selectedCableTypeIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "initialInventoryPerHubCable": { "type": "integer", "minimum": 0, "maximum": 100 },
        "dailyParticipationRate": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.1 },
        "renderedTravelerCount": { "type": "integer", "minimum": 1, "maximum": 64 }
      }
    }
  },
  "$defs": {
    "place": {
      "type": "object",
      "required": ["id", "label", "nodeId"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "nodeId": { "type": "string", "minLength": 1 }
      }
    }
  }
}
