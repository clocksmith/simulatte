{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orbital Transfer Planner configuration",
  "type": "object",
  "required": [
    "schema",
    "id",
    "defaultArchetype",
    "defaultDepotId",
    "defaultScenarioId",
    "solver",
    "verification"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "simulatte.plugin.orbitalTransferConfig.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "defaultArchetype": {
      "type": "string",
      "minLength": 1
    },
    "defaultDepotId": {
      "type": "string",
      "minLength": 1
    },
    "defaultScenarioId": {
      "type": "string",
      "minLength": 1
    },
    "solver": {
      "type": "object",
      "required": ["prograde", "maxIterations", "toleranceDays"],
      "additionalProperties": false,
      "properties": {
        "prograde": { "type": "boolean" },
        "maxIterations": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "toleranceDays": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "verification": {
      "type": "object",
      "required": ["stepDays", "positionToleranceKm", "velocityToleranceKmS"],
      "additionalProperties": false,
      "properties": {
        "stepDays": { "type": "number", "exclusiveMinimum": 0, "maximum": 5 },
        "positionToleranceKm": { "type": "number", "exclusiveMinimum": 0 },
        "velocityToleranceKmS": { "type": "number", "exclusiveMinimum": 0 }
      }
    }
  }
}
