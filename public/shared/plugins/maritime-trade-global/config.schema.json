{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Maritime Trade Global configuration",
  "type": "object",
  "required": [
    "schema",
    "id",
    "defaultVesselClass",
    "defaultScenarioId",
    "defaultSpeedPolicy",
    "cargoTeu",
    "containerCount",
    "ensembleReplicates",
    "queueArrivalCount",
    "arrivalRatePerHour",
    "serviceSigma"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "simulatte.plugin.maritimeTradeConfig.v2"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "defaultVesselClass": {
      "type": "string",
      "minLength": 1
    },
    "defaultScenarioId": {
      "type": "string",
      "minLength": 1
    },
    "defaultSpeedPolicy": {
      "enum": [
        "slow",
        "service",
        "fast"
      ]
    },
    "cargoTeu": {
      "type": "number",
      "minimum": 100,
      "maximum": 24000
    },
    "containerCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "ensembleReplicates": {
      "type": "integer",
      "minimum": 2,
      "maximum": 512
    },
    "queueArrivalCount": {
      "type": "integer",
      "minimum": 2,
      "maximum": 1000
    },
    "arrivalRatePerHour": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 20
    },
    "serviceSigma": {
      "type": "number",
      "minimum": 0,
      "maximum": 2
    }
  }
}
