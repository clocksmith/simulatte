{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sun Walker configuration v3",
  "type": "object",
  "required": [
    "schema",
    "id",
    "seed",
    "maximumAlternatives",
    "directSunWeight",
    "unknownWeight",
    "maximumAddedTimeSeconds",
    "maximumAddedRatio",
    "sampleSpacingM",
    "walkingSpeedMps",
    "minimumSolarElevationDegrees",
    "treeCanopyParticipation",
    "weatherParticipation",
    "canopyShadeThreshold"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "simulatte.plugin.sunWalkerConfig.v3" },
    "id": { "type": "string" },
    "seed": { "type": "string", "minLength": 1 },
    "maximumAlternatives": { "type": "integer", "minimum": 1, "maximum": 8 },
    "directSunWeight": { "type": "number", "minimum": 0 },
    "unknownWeight": { "type": "number", "minimum": 0 },
    "maximumAddedTimeSeconds": { "type": "number", "minimum": 0 },
    "maximumAddedRatio": { "type": "number", "minimum": 0 },
    "sampleSpacingM": { "type": "number", "exclusiveMinimum": 0 },
    "walkingSpeedMps": { "type": "number", "exclusiveMinimum": 0, "maximum": 3 },
    "minimumSolarElevationDegrees": { "type": "number", "exclusiveMinimum": 0, "maximum": 15 },
    "treeCanopyParticipation": { "type": "boolean" },
    "weatherParticipation": { "type": "boolean" },
    "canopyShadeThreshold": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
