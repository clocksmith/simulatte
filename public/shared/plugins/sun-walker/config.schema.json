{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sun Walker configuration v4",
  "type": "object",
  "required": [
    "schema",
    "id",
    "seed",
    "directSunWeight",
    "unknownWeight",
    "maximumAddedTimeSeconds",
    "maximumAddedRatio",
    "routeTimeBucketSeconds",
    "maximumSearchLabels",
    "sampleSpacingM",
    "walkingSpeedMps",
    "minimumSolarElevationDegrees",
    "treeCanopyParticipation",
    "weatherParticipation",
    "canopyShadeThreshold",
    "routeSearchPrecision",
    "maximumLabelsPerNode"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "simulatte.plugin.sunWalkerConfig.v4"
    },
    "id": {
      "type": "string"
    },
    "seed": {
      "type": "string",
      "minLength": 1
    },
    "directSunWeight": {
      "type": "number",
      "minimum": 0
    },
    "unknownWeight": {
      "type": "number",
      "minimum": 0
    },
    "maximumAddedTimeSeconds": {
      "type": "number",
      "minimum": 0
    },
    "maximumAddedRatio": {
      "type": "number",
      "minimum": 0
    },
    "routeTimeBucketSeconds": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "maximumSearchLabels": {
      "type": "integer",
      "minimum": 1
    },
    "sampleSpacingM": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "walkingSpeedMps": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 3
    },
    "minimumSolarElevationDegrees": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 15
    },
    "treeCanopyParticipation": {
      "type": "boolean"
    },
    "weatherParticipation": {
      "type": "boolean"
    },
    "canopyShadeThreshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "routeSearchPrecision": {
      "type": "string",
      "enum": [
        "bucketed",
        "exact"
      ]
    },
    "maximumLabelsPerNode": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    }
  }
}
