{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Subsea Network Global configuration",
  "type": "object",
  "required": [
    "schema",
    "id",
    "topologyDatasetId",
    "landingDatasetId",
    "demandScenarioId",
    "capacityScenarioId",
    "repairScenarioId",
    "allocationPolicyId",
    "comparisonPolicyId",
    "repairPolicyId",
    "failureIds",
    "jurisdictionExclusions",
    "essentialServiceWeight",
    "repairResourceCount",
    "pathLimitPerCommodity",
    "solver",
    "ensembleSeeds",
    "ensembleSize",
    "startInstant",
    "durationHours",
    "stepMinutes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "simulatte.plugin.subseaNetworkConfig.v1"
    },
    "id": {
      "const": "subsea-network-global-config-v1"
    },
    "topologyDatasetId": {
      "const": "subsea-cable-corridors-modeled-v1"
    },
    "landingDatasetId": {
      "const": "subsea-landing-points-governed-v1"
    },
    "demandScenarioId": {
      "type": "string",
      "minLength": 1
    },
    "capacityScenarioId": {
      "type": "string",
      "minLength": 1
    },
    "repairScenarioId": {
      "type": "string",
      "minLength": 1
    },
    "allocationPolicyId": {
      "enum": [
        "weighted-throughput",
        "proportional-fair",
        "essential-service-priority",
        "geographic-equity"
      ]
    },
    "comparisonPolicyId": {
      "enum": [
        "weighted-throughput",
        "proportional-fair",
        "essential-service-priority",
        "geographic-equity"
      ]
    },
    "repairPolicyId": {
      "enum": [
        "nearest-first",
        "unmet-demand-first"
      ]
    },
    "failureIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "jurisdictionExclusions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "essentialServiceWeight": {
      "type": "number",
      "minimum": 1,
      "maximum": 20
    },
    "repairResourceCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "pathLimitPerCommodity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "solver": {
      "type": "object",
      "required": [
        "relativeTolerance",
        "absoluteTolerance",
        "maximumIterations",
        "regularizationEpsilon"
      ],
      "additionalProperties": false,
      "properties": {
        "relativeTolerance": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "absoluteTolerance": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maximumIterations": {
          "type": "integer",
          "minimum": 16,
          "maximum": 4096
        },
        "regularizationEpsilon": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "ensembleSeeds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "ensembleSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "startInstant": {
      "type": "string",
      "format": "date-time"
    },
    "durationHours": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "stepMinutes": {
      "type": "integer",
      "minimum": 1
    }
  }
}
