{
  "schema": "simulatte.systemDiagram.v1",
  "id": "rag-assistant",
  "name": "Synthetic RAG application",
  "description": "Synthetic RAG application with CPU/GPU stages, batched embedding, vector-index queries, reranking and structured model output. A document feed shares the same embedding/index services through a bounded chunker; no actual inference or semantic retrieval occurs.",
  "seed": 42,
  "run": {
    "horizonSec": 30
  },
  "classes": [],
  "nodes": [
    {
      "id": "questions",
      "classId": "nl-input",
      "label": "Natural-language clients",
      "x": 0,
      "y": 110,
      "params": {
        "pattern": "constant",
        "ratePerSec": 1,
        "maxRequests": 6,
        "stopSec": 6,
        "tokensMean": 30,
        "timeoutMs": 10000
      }
    },
    {
      "id": "api",
      "classId": "web-server",
      "label": "CPU prompt API",
      "x": 240,
      "y": 110,
      "params": {
        "serviceMs": 2,
        "serviceDist": "constant"
      }
    },
    {
      "id": "gpu",
      "classId": "gpu-worker",
      "label": "GPU batch stage",
      "x": 480,
      "y": 110,
      "params": {
        "maxBatch": 4,
        "batchWindowMs": 20,
        "batchBaseMs": 10,
        "perItemMs": 2
      }
    },
    {
      "id": "rag",
      "classId": "rag-retriever",
      "label": "RAG call orchestrator",
      "x": 720,
      "y": 110,
      "params": {
        "topK": 3,
        "chunkTokens": 20,
        "promptTokens": 10,
        "callTimeoutMs": 3000,
        "retries": 1
      }
    },
    {
      "id": "embed-timing",
      "classId": "embedder",
      "label": "Embedding service",
      "x": 960,
      "y": -60,
      "params": {
        "workers": 2,
        "maxBatch": 8,
        "batchWindowMs": 5,
        "batchBaseMs": 5,
        "perKTokensMs": 1,
        "dims": 128
      }
    },
    {
      "id": "candidates",
      "classId": "vector-index",
      "label": "Shared vector index",
      "x": 960,
      "y": 110,
      "params": {
        "vectors": 100,
        "queryBaseMs": 2,
        "queryLogMs": 0.1,
        "upsertMs": 1,
        "dims": 128,
        "topK": 3
      }
    },
    {
      "id": "generator",
      "classId": "structured-llm",
      "label": "Synthetic model response",
      "x": 960,
      "y": 280,
      "params": {
        "outputTokensMean": 12,
        "ttftMs": 15,
        "decodeMsPerToken": 2,
        "schemaFailureRate": 0,
        "toolRounds": 0
      }
    },
    {
      "id": "validation",
      "classId": "structured-response",
      "label": "Structured output validation",
      "x": 1200,
      "y": 280,
      "params": {
        "validateMs": 1,
        "parseFailureRate": 0,
        "maxRepairs": 1
      }
    },
    {
      "id": "ranker",
      "classId": "reranker",
      "label": "Candidate reranker",
      "x": 960,
      "y": 440,
      "params": {
        "serviceMs": 2,
        "serviceDist": "constant",
        "perCandidateMs": 0.2
      }
    },
    {
      "id": "documents",
      "classId": "unstructured-feed",
      "label": "Document ingestion",
      "x": 0,
      "y": 440,
      "params": {
        "pattern": "constant",
        "ratePerSec": 1,
        "maxRequests": 3,
        "stopSec": 3,
        "requestKb": 4,
        "tokensMean": 1200,
        "timeoutMs": 10000,
        "retries": 0
      }
    },
    {
      "id": "chunks",
      "classId": "chunker",
      "label": "Document chunks",
      "x": 480,
      "y": 440,
      "params": {
        "chunkTokens": 500,
        "overlapTokens": 50,
        "serviceMs": 2,
        "perKbMs": 0.1,
        "maxChunks": 16,
        "callTimeoutMs": 5000
      }
    }
  ],
  "edges": [
    {
      "id": "question",
      "from": {
        "nodeId": "questions",
        "portId": "out"
      },
      "to": {
        "nodeId": "api",
        "portId": "in"
      },
      "params": {
        "latencyMs": 2,
        "bandwidthMbps": 1000
      }
    },
    {
      "id": "prepare",
      "from": {
        "nodeId": "api",
        "portId": "calls"
      },
      "to": {
        "nodeId": "gpu",
        "portId": "in"
      },
      "params": {
        "latencyMs": 2,
        "bandwidthMbps": 1000
      }
    },
    {
      "id": "inference",
      "from": {
        "nodeId": "gpu",
        "portId": "calls"
      },
      "to": {
        "nodeId": "rag",
        "portId": "in"
      },
      "params": {
        "latencyMs": 2,
        "bandwidthMbps": 1000
      }
    },
    {
      "id": "embedding",
      "from": {
        "nodeId": "rag",
        "portId": "embed"
      },
      "to": {
        "nodeId": "embed-timing",
        "portId": "in"
      },
      "params": {
        "latencyMs": 2,
        "bandwidthMbps": 1000
      }
    },
    {
      "id": "search",
      "from": {
        "nodeId": "rag",
        "portId": "search"
      },
      "to": {
        "nodeId": "candidates",
        "portId": "in"
      },
      "params": {
        "latencyMs": 2,
        "bandwidthMbps": 1000,
        "op": "read"
      }
    },
    {
      "id": "generate",
      "from": {
        "nodeId": "rag",
        "portId": "generate"
      },
      "to": {
        "nodeId": "validation",
        "portId": "in"
      },
      "params": {
        "latencyMs": 2,
        "bandwidthMbps": 1000
      }
    },
    {
      "id": "generator-call",
      "from": {
        "nodeId": "validation",
        "portId": "generate"
      },
      "to": {
        "nodeId": "generator",
        "portId": "in"
      },
      "params": {
        "latencyMs": 2,
        "bandwidthMbps": 1000
      }
    },
    {
      "id": "rerank",
      "from": {
        "nodeId": "rag",
        "portId": "rerank"
      },
      "to": {
        "nodeId": "ranker",
        "portId": "in"
      },
      "params": {
        "latencyMs": 2,
        "bandwidthMbps": 1000
      }
    },
    {
      "id": "ingest",
      "from": {
        "nodeId": "documents",
        "portId": "out"
      },
      "to": {
        "nodeId": "chunks",
        "portId": "in"
      },
      "params": {
        "latencyMs": 2,
        "bandwidthMbps": 1000
      }
    },
    {
      "id": "embed-chunks",
      "from": {
        "nodeId": "chunks",
        "portId": "chunks"
      },
      "to": {
        "nodeId": "embed-timing",
        "portId": "in"
      },
      "params": {
        "latencyMs": 2,
        "bandwidthMbps": 1000,
        "op": "write"
      }
    },
    {
      "id": "index-chunks",
      "from": {
        "nodeId": "chunks",
        "portId": "chunks"
      },
      "to": {
        "nodeId": "candidates",
        "portId": "in"
      },
      "params": {
        "latencyMs": 2,
        "bandwidthMbps": 1000,
        "op": "write"
      }
    }
  ],
  "groups": [],
  "notes": [],
  "faults": [],
  "view": {
    "x": 0,
    "y": 0,
    "zoom": 1
  }
}
