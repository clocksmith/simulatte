{
  "schema": "simulatte.systemDiagram.v1",
  "id": "rag-assistant",
  "name": "Synthetic RAG application",
  "description": "Natural-language requests cross CPU/GPU stages and explicit embed/search/generate calls. GPU embedding and candidate DB are timing adapters, not real embeddings, ANN search or model quality.",
  "seed": 42,
  "run": {
    "horizonSec": 30
  },
  "classes": [],
  "nodes": [
    {
      "id": "questions",
      "classId": "nl-input",
      "label": "Natural-language clients",
      "x": 0,
      "y": 110,
      "params": {
        "pattern": "constant",
        "ratePerSec": 1,
        "maxRequests": 6,
        "stopSec": 6,
        "tokensMean": 30,
        "timeoutMs": 10000
      }
    },
    {
      "id": "api",
      "classId": "web-server",
      "label": "CPU prompt API",
      "x": 240,
      "y": 110,
      "params": {
        "serviceMs": 2,
        "serviceDist": "constant"
      }
    },
    {
      "id": "gpu",
      "classId": "gpu-worker",
      "label": "GPU batch stage",
      "x": 480,
      "y": 110,
      "params": {
        "maxBatch": 4,
        "batchWindowMs": 20,
        "batchBaseMs": 10,
        "perItemMs": 2
      }
    },
    {
      "id": "rag",
      "classId": "rag-retriever",
      "label": "RAG call orchestrator",
      "x": 720,
      "y": 110,
      "params": {
        "topK": 3,
        "chunkTokens": 20,
        "promptTokens": 10,
        "callTimeoutMs": 3000,
        "retries": 1
      }
    },
    {
      "id": "embed-timing",
      "classId": "gpu-worker",
      "label": "Synthetic embed timing",
      "x": 960,
      "y": -60,
      "params": {
        "maxBatch": 4,
        "batchBaseMs": 5,
        "perItemMs": 1,
        "batchWindowMs": 5
      }
    },
    {
      "id": "candidates",
      "classId": "database",
      "label": "Synthetic candidate rows",
      "x": 960,
      "y": 110,
      "params": {
        "readMs": 3,
        "serviceDist": "constant"
      }
    },
    {
      "id": "generator",
      "classId": "structured-llm",
      "label": "Synthetic model response",
      "x": 960,
      "y": 280,
      "params": {
        "outputTokensMean": 12,
        "ttftMs": 15,
        "decodeMsPerToken": 2,
        "schemaFailureRate": 0,
        "toolRounds": 0
      }
    },
    {
      "id": "validation",
      "classId": "structured-response",
      "label": "Structured output validation",
      "x": 1200,
      "y": 280,
      "params": {
        "validateMs": 1,
        "parseFailureRate": 0,
        "maxRepairs": 1
      }
    }
  ],
  "edges": [
    {
      "id": "question",
      "from": {
        "nodeId": "questions",
        "portId": "out"
      },
      "to": {
        "nodeId": "api",
        "portId": "in"
      },
      "params": {
        "latencyMs": 2,
        "bandwidthMbps": 1000
      }
    },
    {
      "id": "prepare",
      "from": {
        "nodeId": "api",
        "portId": "calls"
      },
      "to": {
        "nodeId": "gpu",
        "portId": "in"
      },
      "params": {
        "latencyMs": 2,
        "bandwidthMbps": 1000
      }
    },
    {
      "id": "inference",
      "from": {
        "nodeId": "gpu",
        "portId": "calls"
      },
      "to": {
        "nodeId": "rag",
        "portId": "in"
      },
      "params": {
        "latencyMs": 2,
        "bandwidthMbps": 1000
      }
    },
    {
      "id": "embedding",
      "from": {
        "nodeId": "rag",
        "portId": "embed"
      },
      "to": {
        "nodeId": "embed-timing",
        "portId": "in"
      },
      "params": {
        "latencyMs": 2,
        "bandwidthMbps": 1000
      }
    },
    {
      "id": "search",
      "from": {
        "nodeId": "rag",
        "portId": "search"
      },
      "to": {
        "nodeId": "candidates",
        "portId": "in"
      },
      "params": {
        "latencyMs": 2,
        "bandwidthMbps": 1000,
        "op": "read"
      }
    },
    {
      "id": "generate",
      "from": {
        "nodeId": "rag",
        "portId": "generate"
      },
      "to": {
        "nodeId": "validation",
        "portId": "in"
      },
      "params": {
        "latencyMs": 2,
        "bandwidthMbps": 1000
      }
    },
    {
      "id": "generator-call",
      "from": {
        "nodeId": "validation",
        "portId": "generate"
      },
      "to": {
        "nodeId": "generator",
        "portId": "in"
      },
      "params": {
        "latencyMs": 2,
        "bandwidthMbps": 1000
      }
    }
  ],
  "groups": [],
  "notes": [],
  "faults": [],
  "view": {
    "x": 0,
    "y": 0,
    "zoom": 1
  }
}
