          "y": 0,
          "params": {
            "memoryPerRequestMiB": 1,
            "memoryLimitMiB": 1024,
            "memoryPressureThreshold": 0.8,
            "memoryThrashFactor": 1,
            "memoryGarbageFraction": 0,
            "memoryGcPauseMs": 0,
            "memoryGcCooldownMs": 1000,
            "memoryOomRecoveryMs": 1000,
            "memoryOomPolicy": "reject",
            "validateMs": 1,
            "maxRepairs": 0,
            "parseFailureRate": 0,
            "concurrency": 64,
            "queueCapacity": 1000,
            "callTimeoutMs": 30000,
            "responseKb": 2
          }
        },
        {
          "id": "records",
          "classId": "idempotent-store",
          "label": "Structured records",
          "x": 720,
          "y": 220,
          "params": {
            "readMs": 2,
            "writeMs": 3,
            "serviceDist": "constant",
            "serviceCv": 1,
            "connections": 50,
            "queueCapacity": 1000,
            "perKbMs": 0,
            "errorRate": 0,
            "responseKb": 1,
            "idempotentWrites": true,
            "idempotencyWindowSec": 300
