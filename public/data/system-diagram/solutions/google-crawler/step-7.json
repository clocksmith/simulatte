          "x": 960,
          "y": 220,
          "params": {
            "memoryPerRequestMiB": 1,
            "memoryLimitMiB": 1024,
            "memoryPressureThreshold": 0.8,
            "memoryThrashFactor": 1,
            "memoryGarbageFraction": 0,
            "memoryGcPauseMs": 0,
            "memoryGcCooldownMs": 1000,
            "memoryOomRecoveryMs": 1000,
            "memoryOomPolicy": "reject",
            "baseMs": 5,
            "throughputMBps": 10,
            "serviceDist": "constant",
            "serviceCv": 0.5,
            "concurrency": 1000,
            "queueCapacity": 10000,
            "errorRate": 0
          }
        }
      ],
      "edges": [
        {
          "id": "validate",
          "from": {
            "nodeId": "parser",
            "portId": "calls"
          },
          "to": {
            "nodeId": "validator",
            "portId": "in"
          },
          "params": {
            "latencyMs": 2,
            "bandwidthMbps": 1000
          }
        },
        {
          "id": "persist",
          "from": {
            "nodeId": "parser",
            "portId": "calls"
          },
          "to": {
            "nodeId": "records",
            "portId": "in"
          },
          "params": {
            "latencyMs": 2,
            "bandwidthMbps": 1000,
            "op": "write",
            "order": 1
          }
        },
        {
          "id": "archive-copy",
          "from": {
            "nodeId": "parser",
            "portId": "calls"
          },
          "to": {
            "nodeId": "archive",
            "portId": "in"
          },
          "params": {
            "latencyMs": 2,
            "bandwidthMbps": 1000,
            "op": "write",
            "mode": "async",
            "order": 2
          }
        }
      ],
      "groups": [],
      "notes": [],
      "faults": [],
      "ports": [
        {
          "id": "port-1",
          "label": "CPU synthetic parser: Requests",
          "direction": "in",
          "target": {
            "nodeId": "parser",
            "portId": "in"
          }
        },
        {
          "id": "port-2",
          "label": "CPU synthetic parser: Calls",
          "direction": "out",
          "target": {
            "nodeId": "parser",
            "portId": "calls"
          }
        },
        {
          "id": "port-3",
          "label": "Structured validator: Input",
          "direction": "in",
          "target": {
            "nodeId": "validator",
            "portId": "in"
          }
        },
        {
          "id": "port-4",
          "label": "Structured validator: Generator",
          "direction": "out",
          "target": {
            "nodeId": "validator",
            "portId": "generate"
          }
        },
        {
          "id": "port-5",
          "label": "Structured records: Queries",
          "direction": "in",
          "target": {
            "nodeId": "records",
            "portId": "in"
          }
        },
        {
          "id": "port-6",
          "label": "Synthetic object archive: Objects",
          "direction": "in",
          "target": {
            "nodeId": "archive",
            "portId": "in"
          }
