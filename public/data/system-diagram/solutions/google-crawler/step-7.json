{
  "schema": "simulatte.systemDiagram.v4",
  "id": "google-crawler",
  "name": "Distributed web crawler / Separate committed work from a lost reply",
  "description": "An autonomous bounded crawler models per-origin delay, deduplication and provenance. Cron adds scheduled tasks to a shared CPU parser and database; no real scraping or content extraction occurs.",
  "seed": 42,
  "run": {
    "horizonSec": 30
  },
  "classes": [],
  "nodes": [
    {
      "id": "crawler",
      "classId": "crawler",
      "label": "Synthetic crawler",
      "x": 0,
      "y": 0,
      "params": {
        "seedUrls": 3,
        "domains": 2,
        "fetchConcurrency": 2,
        "politenessMs": 100,
        "linksPerPage": 1,
        "duplicateRate": 0.5,
        "maxPages": 8,
        "pageKbMean": 2,
        "timeoutMs": 3000,
        "retries": 1,
        "stopSec": 10
      }
    },
    {
      "id": "website",
      "classId": "website",
      "label": "Synthetic website",
      "x": 240,
      "y": -120,
      "params": {
        "serviceMs": 20,
        "serviceDist": "constant",
        "rateLimitPerSec": 20,
        "responseKb": 2
      }
    },
    {
      "id": "subsystem-1",
      "classId": "subsystem.crawl-processing@1",
      "label": "Crawl processing",
      "x": 480,
      "y": 0,
      "params": {},
      "overrides": {}
    }
  ],
  "edges": [
    {
      "id": "fetch",
      "from": {
        "nodeId": "crawler",
        "portId": "fetch"
      },
      "to": {
        "nodeId": "website",
        "portId": "in"
      },
      "params": {
        "latencyMs": 2,
        "bandwidthMbps": 1000
      }
    },
    {
      "id": "documents",
      "from": {
        "nodeId": "crawler",
        "portId": "documents"
      },
      "to": {
        "nodeId": "subsystem-1",
        "portId": "port-1"
      },
      "params": {
        "latencyMs": 2,
        "bandwidthMbps": 1000
      }
    }
  ],
  "groups": [],
  "notes": [],
  "faults": [
    {
      "id": "uncertain-ack",
      "atSec": 0,
      "untilSec": 0.5,
      "target": {
        "kind": "node",
        "id": "website"
      },
      "type": "dropReplies",
      "params": {}
    }
  ],
  "view": {
    "x": 0,
    "y": 0,
    "zoom": 1
  },
  "subsystems": [
    {
      "id": "crawl-processing",
      "version": 1,
      "label": "Crawl processing",
      "nodes": [
        {
          "id": "parser",
          "classId": "worker",
          "label": "CPU synthetic parser",
          "x": 480,
          "y": 80,
          "params": {
            "concurrency": 4,
            "queueCapacity": 1000,
            "serviceMs": 5,
            "serviceDist": "constant",
            "serviceCv": 1,
            "perKbMs": 0,
            "errorRate": 0,
            "responseKb": 1,
            "callMode": "sequential",
            "blockingCalls": true,
            "callTimeoutMs": 2000,
            "retries": 0,
            "retryBackoffMs": 100,
            "backoffMultiplier": 2,
            "retryJitter": true,
            "memoryPerRequestMiB": 1,
            "memoryLimitMiB": 1024,
            "memoryPressureThreshold": 0.8,
            "memoryThrashFactor": 1,
            "memoryGarbageFraction": 0,
            "memoryGcPauseMs": 0,
            "memoryGcCooldownMs": 1000,
            "memoryOomRecoveryMs": 1000,
            "memoryOomPolicy": "reject",
            "outputPayload": "json"
