  "seed": 42,
  "run": {
    "horizonSec": 20
  },
  "classes": [],
  "nodes": [
    {
      "id": "uploads",
      "classId": "operation-client",
      "label": "uploads",
      "x": 0,
      "y": 0,
      "params": {
        "operation": "publishStory",
        "count": 3,
        "intervalMs": 400,
        "actorSpace": 1
      }
    },
    {
