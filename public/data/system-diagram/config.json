{
  "schema": "simulatte.systemDiagramConfig.v1",
  "version": "1.3.0",
  "privateCollectionPath": "/data/system-diagram/private-collection.enc.json",
  "model": "system-diagram/v1",
  "classLibraryPath": "/data/system-diagram/class-library.json",
  "engine": {
    "authoritativeCadenceSec": 0.5,
    "maxInFlight": 50000,
    "maxHops": 64,
    "histogram": {
      "minMs": 0.01,
      "maxMs": 3600000,
      "bins": 400
