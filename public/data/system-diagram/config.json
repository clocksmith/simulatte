      0.1,
      0.25,
      0.5,
      1,
      2,
      5,
      10,
      20
    ],
    "defaultSpeed": 0.5,
    "maxSimSecondsPerFrame": 1
  },
  "editor": {
    "historyLimit": 200,
    "autosaveKey": "simulatte.systemDiagram.draft.v1",
    "grid": 8,
    "nodeWidth": 176,
    "nodeHeight": 72,
    "minZoom": 0.2,
    "maxZoom": 3,
    "fitMinZoom": 1e-05
