        },
        "queueCapacity": {
          "type": "integer",
          "label": "Queue capacity",
          "unit": "requests",
          "min": 0,
          "max": 100000,
          "default": 1000,
          "group": "advanced"
        },
        "callTimeoutMs": {
          "type": "number",
          "label": "Generator timeout",
          "unit": "ms",
          "min": 1,
          "max": 3600000,
          "default": 30000,
          "group": "advanced"
        },
        "responseKb": {
          "type": "number",
          "label": "JSON size",
          "unit": "KB",
          "min": 0,
          "max": 1000000,
          "default": 2,
          "group": "advanced"
        }
      },
      "ports": [
        {
          "id": "in",
          "direction": "in",
          "label": "Input",
          "accepts": [
            "text",
            "document",
            "json",
            "query",
            "http"
          ],
          "multiple": true,
          "required": true
        },
        {
          "id": "generate",
          "direction": "out",
