      "label": "Video viewers",
      "kernel": "videoViewers",
      "category": "clients",
      "glyph": "users",
      "description": "Aggregates up to one million viewers into bounded cohorts downloading named segments. Peer partial delivery falls back to CDN. Startup and rebuffer metrics wait for each cohort member; this conservative synthetic model does not execute media codecs or WebRTC.",
      "defaults": {}
    },
    {
      "id": "video-origin",
      "label": "Video origin",
