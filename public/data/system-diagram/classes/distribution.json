      "defaults": {
        "serviceMs": 2,
        "serviceDist": "constant",
        "memoryPerRequestMiB": 0
      }
    },
    {
      "id": "video-peers",
      "label": "Peer assistance",
      "kernel": "videoPeers",
      "category": "edge",
      "glyph": "topic",
      "description": "Learns downloaded segments from viewer cohort receipts. Available peers share a per-window upload budget across assets, exclude self-assistance, churn, and may use an authored relay fraction. This is not actual WebRTC signaling, ICE, NAT traversal or transport.",
      "defaults": {
        "serviceMs": 2,
        "serviceDist": "constant",
        "memoryPerRequestMiB": 0
      }
    },
    {
      "id": "spark-driver",
      "label": "Spark-style driver",
      "kernel": "sparkDriver",
      "category": "data",
      "glyph": "cog",
      "description": "Generates a configurable synthetic URL record input, dispatches named map partitions, waits for their shuffle dependencies, and dispatches keyed reductions to drawn executors. Missing executor-local shuffle blocks trigger bounded lineage recomputation. Outputs real URL counts.",
      "defaults": {}
    },
    {
      "id": "spark-executor",
      "label": "Spark-style executor",
      "kernel": "sparkExecutor",
      "category": "compute",
      "glyph": "server",
      "description": "Executes actual URL map and reduce operations in shared resource queues. Retains named executor-local shuffle blocks, fetches remote dependencies over explicit shuffle edges, accounts skew and synthetic RAM/disk spill cost, and loses volatile shuffle data on crash.",
      "defaults": {
        "concurrency": 2,
        "serviceMs": 2,
        "serviceDist": "constant",
        "memoryPerRequestMiB": 0
      }
    }
  ]
}
