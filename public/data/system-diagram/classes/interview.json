          "type": "integer",
          "label": "Keys",
          "default": 8,
          "min": 1,
          "max": 200,
          "group": "basic"
        },
        "actorSpace": {
          "type": "integer",
          "label": "Users",
          "default": 8,
          "min": 1,
          "max": 200,
          "group": "basic"
        },
        "value": {
          "type": "number",
          "label": "Value",
          "default": 1,
          "min": -1,
          "max": 1,
          "group": "basic"
        },
