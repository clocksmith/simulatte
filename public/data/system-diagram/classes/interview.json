        "operation": {
          "type": "enum",
          "label": "Operation",
          "options": [
            "comment",
            "vote",
            "readComments",
            "publishStory",
            "readStory",
            "reserve",
            "pay",
            "readInventory",
            "heartbeat",
            "subscribe",
            "readPresence"
          ],
          "default": "comment",
          "group": "basic"
        },
        "count": {
          "type": "integer",
          "label": "Operations",
          "default": 8,
          "min": 1,
          "max": 200,
          "group": "basic"
        },
        "intervalMs": {
          "type": "number",
          "label": "Interval",
          "default": 400,
          "min": 1,
          "max": 10000,
          "group": "basic"
        },
        "startSec": {
          "type": "number",
          "label": "Start",
          "default": 0,
          "min": 0,
          "max": 3600,
          "group": "basic"
