          "type": "number",
          "label": "Timeout",
          "default": 3000,
          "min": 1,
          "max": 60000,
          "group": "basic"
        },
        "retries": {
          "type": "integer",
          "label": "Retries",
          "default": 0,
          "min": 0,
          "max": 5,
          "group": "basic"
