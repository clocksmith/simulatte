{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "System Diagram Simulator profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "name",
    "route",
    "entry",
    "model",
    "configPath",
    "defaultSeed",
    "defaultPolicy",
    "capabilities",
    "limitations"
  ],
  "properties": {
    "schema": {
      "const": "simulatte.systemDiagramProfile.v1"
    },
    "id": {
      "const": "system-diagram-v1"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "route": {
      "const": "/system-diagram"
    },
    "entry": {
      "const": "/simulatte/distributed-repair/index.html"
    },
    "model": {
      "const": "distributed-repair/v1"
    },
    "configPath": {
      "const": "/data/distributed-repair/config.json"
    },
    "defaultSeed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "defaultPolicy": {
      "enum": [
        "baseline",
        "bounded"
      ]
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "node-authoring",
          "typed-task-links",
          "shared-gpu-clusters",
          "capacity-latency",
          "seeded-replay",
          "checkpoint-restore",
          "causal-request-inspection"
        ]
      }
    },
    "limitations": {
      "type": "string",
      "minLength": 1
    }
  }
}
