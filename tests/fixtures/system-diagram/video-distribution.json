    {
      "id": "viewers",
      "classId": "video-viewers",
      "label": "3,000 viewers in 12 cohorts",
      "x": 0,
      "y": 140,
      "params": {}
    },
    {
      "id": "cdn",
      "classId": "video-cdn",
      "label": "Regional segment CDN",
      "x": 320,
      "y": 40,
      "params": {}
    },
    {
      "id": "origin",
      "classId": "video-origin",
      "label": "Asset origin",
      "x": 640,
      "y": 40,
      "params": {}
    },
    {
      "id": "peers",
      "classId": "video-peers",
      "label": "Peer availability and upload",
      "x": 320,
      "y": 280,
      "params": {}
    }
  ],
  "edges": [
    {
      "id": "viewers-cdn",
      "from": {
