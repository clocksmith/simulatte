      },
      "params": {
        "latencyMs": 25,
        "bandwidthMbps": 500,
        "bandwidthSharing": "fair"
      },
      "label": "Fetch missing segment once"
    },
    {
      "id": "viewers-peers",
      "from": {
        "nodeId": "viewers",
        "portId": "peers"
      },
      "to": {
        "nodeId": "peers",
