{
  "schema": "simulatte.systemDiagram.v2",
  "id": "video-distribution",
  "name": "Video segments: CDN and bounded peer assistance",
  "description": "Three thousand viewers share twelve aggregate cohorts. Exact segment identities traverse the CDN cache and origin, or bounded peer assistance. Observe startup, rebuffer, cache hit/miss, origin, peer and relay byte costs. A peer outage falls back to CDN.",
