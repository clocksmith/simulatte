      "derivation": "One bounded synthetic crawler fetch produces exactly one capped chunk and one index upsert, published before questions at 0.1/0.3 s. First question reaches a tool during outage until0.15 s and fails without retries; second succeeds. A single100ms retry repairs first question. Typed embed/search/generate and structured validation all execute; provider output is configured valid, while malformed-output repair is independently tested elsewhere.",
      "malformedProbe": {
        "nodes": {
          "agent": {
            "schemaFailureRate": 1
          },
          "shape": {
            "maxRepairs": 1
          }
        },
        "expected": {
          "offered": 3,
          "completed": 1,
          "failed": 2,
          "effects": 1,
          "duplicateEffects": 0,
          "nodes": {
            "shape": {
              "detail": {
                "repairs": 2,
                "invalid": 2,
                "valid": 0
              }
            },
            "agent": {
              "arrivals": 4
            },
            "crawler": {
              "detail": {
                "pages fetched": 1
              }
            }
          }
        },
        "derivation": "Starting from repaired tool-retry policy, force every synthetic structured output invalid. Two questions each consume one extra repair call, so four agent arrivals and two terminal invalid requests. The one independent crawler ingestion still completes."
      },
      "staleProbe": {
        "nodes": {
          "index": {
            "visibilityDelayMs": 4000
          }
        },
        "expected": {
          "offered": 3,
          "completed": 1,
          "failed": 2,
          "effects": 1,
          "duplicateEffects": 0,
          "nodes": {
            "index": {
              "detail": {
                "vectors": 0,
                "queries": 2,
                "upserts": 1,
                "pending upserts": 1,
                "stale queries": 2
              }
            },
            "rag": {
              "detail": {
                "answered": 0
              }
            },
            "shape": {
              "arrivals": 0
            },
            "agent": {
              "arrivals": 0
            },
            "crawler": {
              "detail": {
                "pages fetched": 1
              }
            }
          }
        },
        "derivation": "The single crawled-document upsert acknowledges around3ms but a4s publication delay lies beyond the3s horizon. Questions at0.1/0.3s both see zero visible candidates and stale=true. rejectStaleResults=true refuses both before generation; crawler ingestion acknowledgement remains complete and the index pending-publication count remains1."
      }
