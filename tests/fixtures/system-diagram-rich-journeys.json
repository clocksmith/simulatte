{
  "schema": "simulatte.blankJourneyPlans.v1",
  "families": [
    {
      "id": "streaming",
      "label": "GPU stream fan-out, cache outage and slow acknowledgement",
      "seed": 42,
      "horizonSec": 3,
      "nodes": [
        {
          "id": "source",
          "classId": "burst-producer",
          "params": {
            "pattern": "burst",
            "burstCount": 4,
            "burstAtSec": 0,
            "burstSpacingMs": 0,
            "maxRequests": 4,
            "payload": "blob",
            "requestKb": 1,
            "keySpace": 1,
            "readFraction": 1,
            "retries": 0,
            "timeoutMs": 2000
          }
        },
        {
          "id": "gpu",
          "classId": "gpu-worker",
          "params": {
            "maxBatch": 4,
            "batchWindowMs": 10,
            "batchBaseMs": 10,
            "perItemMs": 0,
            "workers": 1,
            "callTimeoutMs": 1000,
            "retries": 0
          }
        },
        {
          "id": "fanout",
          "classId": "stream-fanout",
          "params": {
            "concurrency": 1,
            "queueCapacity": 1,
            "serviceMs": 0,
            "serviceDist": "constant",
            "callTimeoutMs": 1000,
            "callMode": "parallel",
            "retries": 0
          }
        },
        {
          "id": "consumer",
          "classId": "stream-consumer",
          "params": {
            "concurrency": 1,
            "queueCapacity": 4,
            "serviceMs": 100,
            "serviceDist": "constant",
            "responseKb": 0
          }
        },
        {
          "id": "cdn",
          "classId": "cdn-edge",
          "params": {
            "capacityKeys": 8,
            "ttlSec": 10,
            "hitMs": 0,
            "failOpen": false,
            "callTimeoutMs": 1000
          }
        },
        {
          "id": "origin",
          "classId": "object-store",
          "params": {
            "baseMs": 1,
            "serviceDist": "constant",
            "throughputMBps": 1000
          }
        }
      ],
      "edges": [
        {
          "id": "to-gpu",
          "from": "source",
          "fromPort": "out",
          "to": "gpu",
          "toPort": "in",
          "params": {
            "latencyMs": 0,
            "jitterMs": 0,
            "bandwidthMbps": 1000000
          }
        },
        {
          "id": "to-fanout",
          "from": "gpu",
          "fromPort": "calls",
          "to": "fanout",
          "toPort": "in",
          "params": {
            "latencyMs": 0,
            "jitterMs": 0,
            "bandwidthMbps": 1000000
          }
        },
        {
          "id": "to-consumer",
          "from": "fanout",
          "fromPort": "calls",
          "to": "consumer",
          "toPort": "in",
          "params": {
            "latencyMs": 0,
            "jitterMs": 0,
            "bandwidthMbps": 1000000
          }
        },
        {
          "id": "to-cdn",
          "from": "fanout",
          "fromPort": "calls",
          "to": "cdn",
          "toPort": "in",
          "params": {
            "latencyMs": 0,
            "jitterMs": 0,
            "bandwidthMbps": 1000000
          }
        },
        {
          "id": "origin-link",
          "from": "cdn",
          "fromPort": "origin",
          "to": "origin",
          "toPort": "in",
          "params": {
            "latencyMs": 0,
            "jitterMs": 0,
            "bandwidthMbps": 1000000
          }
        }
      ],
      "faults": [
        {
          "target": {
            "kind": "node",
            "id": "cdn"
          },
          "type": "crash",
          "atSec": 0.05,
          "untilSec": 0.15,
          "params": {}
        }
      ],
      "repair": {
        "nodes": {
          "fanout": {
            "queueCapacity": 3
          },
          "cdn": {
            "failOpen": true
          }
        }
      },
      "expected": {
        "baseline": {
          "offered": 4,
          "completed": 1,
          "failed": 3,
          "effects": 0,
          "duplicateEffects": 0,
          "nodes": {
            "gpu": {
              "arrivals": 4,
              "detail": {
                "batches": 1,
                "mean batch": 4
              }
            },
            "fanout": {
              "rejected": 2
            },
            "consumer": {
              "served": 2
            },
            "cdn": {
              "health": "ok",
              "detail": {
                "Flushes": 1,
                "Misses": 1,
                "Hits": 0
              }
            },
            "origin": {
              "arrivals": 1
            }
          }
        },
        "repair": {
          "offered": 4,
          "completed": 4,
          "failed": 0,
          "effects": 0,
          "duplicateEffects": 0,
          "nodes": {
            "gpu": {
              "arrivals": 4,
              "detail": {
                "batches": 1,
                "mean batch": 4
              }
            },
            "fanout": {
              "rejected": 0
            },
            "consumer": {
              "served": 4
            },
            "cdn": {
              "health": "ok",
              "detail": {
                "Flushes": 1,
                "Misses": 2,
                "Hits": 1,
                "bypassed": 1
              }
            },
            "origin": {
              "arrivals": 3
            }
          }
        }
      },
      "derivation": "GPU batch releases four chunks before the first 100 ms consumer acknowledgement. Baseline has one active plus one waiting slot, rejecting two; the remaining second chunk sees a cache outage. Repair admits all four and bypasses the crashed cache to its real origin edge. Repaired cache restarts cold and later fills/hits. Inputs and cache outage are unchanged.",
      "checkpointAtSec": 0.06
    },
    {
